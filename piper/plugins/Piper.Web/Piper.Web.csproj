<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the code the web plugin (plugins/Piper.Plugins.Web) writes calls at run time: answering a handler's Option or
    Result as an HTTP response, and the [Status] attribute choosing an error's status. It comes with the plugin, beside
    its assembly, and a program using the plugin references it (IPiperPlugin.References).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Piper.Web</RootNamespace>
    <!-- One place whatever the configuration, so the web plugin can copy it beside itself. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\runtime\</OutDir>
  </PropertyGroup>

  <!--
    htmx 2.0.4 and its server-sent events extension, htmx-ext-sse 2.2.2 (both Zero-Clause BSD, their licences beside
    them), served by apps at /_piper/htmx.min.js and /_piper/htmx-sse.js: see PiperHtmx.cs and PiperLive.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\htmx.min.js" LogicalName="Piper.Web.htmx.min.js" />
    <EmbeddedResource Include="Resources\htmx-sse.js" LogicalName="Piper.Web.htmx-sse.js" />
    <None Include="Resources\htmx.LICENSE.txt" />
    <None Include="Resources\htmx-sse.LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- A program has its own Piper.Runtime; this must use that one, not a copy. -->
    <ProjectReference Include="..\..\src\Piper.Runtime\Piper.Runtime.csproj" Private="false" />
    <!-- Workers, stopping hooks and the shutdown timeout, shared with `host`; the web plugin copies it beside itself. -->
    <ProjectReference Include="..\Piper.Hosting\Piper.Hosting.csproj" Private="false" />
  </ItemGroup>

</Project>
