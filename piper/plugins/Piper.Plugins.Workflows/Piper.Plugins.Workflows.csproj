<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The workflows plugin: durable workflows over Piper.Workflows, replayed from their history so they survive
    restarts. It's listed in a program's piper.json ("plugins": ["workflows"]) and loaded by the compiler, which never
    references it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One place whatever the configuration, so piper.json files can point at it. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\plugin\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler loads the plugin, so it provides Piper.Compiler; don't copy it next to the plugin. -->
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- What the program calls (IPiperPlugin.References): built first, and copied beside the plugin. -->
    <ProjectReference Include="..\Piper.Workflows\Piper.Workflows.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Piper.Workflows\bin\runtime\Piper.Workflows.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
