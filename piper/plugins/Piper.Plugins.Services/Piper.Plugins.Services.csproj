<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A sample Piper compiler plugin: `services { }` for dependency injection with Microsoft.Extensions.DependencyInjection,
    in any program, web or not. It's listed in a program's piper.json ("plugins": [".../Piper.Plugins.Services.dll"])
    and loaded by the compiler, which never references it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One place whatever the configuration, so piper.json files can point at it. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\plugin\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler loads the plugin, so it provides Piper.Compiler; don't copy it next to the plugin. -->
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
