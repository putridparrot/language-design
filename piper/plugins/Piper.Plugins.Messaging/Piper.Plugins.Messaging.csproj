<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The messaging plugin: `messages` (commands and events) and `consumer` declarations, over Piper.Messaging's bus and
    whichever transport the app chooses by configuration (the in-memory one locally). It's listed in a program's
    piper.json ("plugins": ["messaging"]) and loaded by the compiler, which never references it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One place whatever the configuration, so piper.json files can point at it. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\plugin\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler loads the plugin, so it provides Piper.Compiler; don't copy it next to the plugin. -->
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- What the code the plugin writes calls (IPiperPlugin.References): built first, and copied beside the plugin. -->
    <ProjectReference Include="..\Piper.Messaging\Piper.Messaging.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Piper.Messaging\bin\runtime\Piper.Messaging.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Which types are data that can cross a process: the actor plugins' check, shared. -->
    <Compile Include="..\Piper.Plugins.Actors\ActorSyntax.cs" Link="ActorSyntax.cs" />
  </ItemGroup>

</Project>
