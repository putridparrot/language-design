<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The telemetry plugin: no syntax of its own, it brings OpenTelemetry and Piper.Telemetry, which a `server` or `host`
    with `telemetry;` calls. It's listed in a program's piper.json ("plugins": ["web", "telemetry"]) and loaded by the
    compiler, which never references it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One place whatever the configuration, so piper.json files can point at it. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\plugin\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler loads the plugin, so it provides Piper.Compiler; don't copy it next to the plugin. -->
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- What a program using the plugin calls (IPiperPlugin.References): built first, and copied beside the plugin. -->
    <ProjectReference Include="..\Piper.Telemetry\Piper.Telemetry.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Piper.Telemetry\bin\runtime\Piper.Telemetry.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
