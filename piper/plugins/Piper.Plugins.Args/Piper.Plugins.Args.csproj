<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The args plugin: `args Options { port: int = 5080; }`, command-line options as a record. It comes with piper
    ("plugins": ["args"]) and is loaded by the compiler, which never references it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- One place whatever the configuration, so piper.json files can point at it. -->
    <OutDir>$(MSBuildThisFileDirectory)bin\plugin\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler loads the plugin, so it provides Piper.Compiler; don't copy it next to the plugin. -->
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
