<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata shared by the Piper tool, Piper.Build and Piper.Runtime. -->
    <!--
      VersionPrefix is the release. A local `dotnet pack` stamps a fourth part, the minutes since 2026-01-01, so each
      pack is newer than the last (and than the release it builds on) and `dotnet tool update` (see README.md)
      replaces an installed piper. A release packs with -p:PiperRelease=true, and -p:VersionPrefix=x.y.z for
      another number (as CI does for a piper-vx.y.z tag, in .github/workflows/piper.yml).
      Assembly versions stay at the release, so plugins built by one local pack load in the next.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <PiperBuild>$([System.Math]::Floor($([MSBuild]::Divide($([MSBuild]::Subtract($([System.DateTime]::UtcNow.Ticks), 639028224000000000)), 600000000))))</PiperBuild>
    <Version Condition="'$(_IsPacking)' == 'true' and '$(PiperRelease)' != 'true'">$(VersionPrefix).$(PiperBuild)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Authors>Mark Timmings</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>piper;language;compiler;transpiler;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/putridparrot/language-design/tree/main/piper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/putridparrot/language-design</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/putridparrot/language-design/blob/main/piper/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
</Project>
