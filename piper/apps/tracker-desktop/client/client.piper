// Talking to the Tracker API: its records as the client sees them, and a client calling it as one user.
namespace TrackerDesktop;

using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Net.Http.Json;
using System.Text.Json;
using System.Threading.Tasks;

record Project(id: int, code: string, name: string);

/// An issue as the API shows it. `next` names what can be done to it now (`["Submit", "Unassign", "Close"]`).
record IssueView(
    id: int, projectId: int, title: string, description: string, priority: string, status: string,
    assignee: string?, resolution: string?, created: DateTime, updated: DateTime, next: List<string>);

record NewIssue(title: string, description: string, priority: string);

record CommentView(id: int, issueId: int, author: string, text: string, created: DateTime);

record NewComment(text: string);

/// Why a call to the API didn't work: the status, and what the API said (its ProblemDetails' detail or title).
record ApiError(status: int, message: string);

/// Calls the Tracker API at `baseAddress`, as `user`. Each call gives its result or why it failed, as a Result.
class TrackerClient(http: HttpClient, user: string) {
    let json = JsonSerializerOptions(JsonSerializerDefaults.Web);

    async fn Projects() => Task<Result<List<Project>, ApiError>> {
        let content = (await Send(HttpMethod.Get, url$"/api/projects", None))?;
        Parsed(JsonSerializer.Deserialize<List<Project>>(content, json))
    }

    async fn Issues(projectId: int, status: string?, text: string?) => Task<Result<List<IssueView>, ApiError>> {
        // Each value is encoded for the query, and one that's None leaves its parameter out.
        let content = (await Send(HttpMethod.Get, url$"/api/projects/{projectId}/issues?status={status}&q={text}", None))?;
        Parsed(JsonSerializer.Deserialize<List<IssueView>>(content, json))
    }

    async fn AddIssue(projectId: int, issue: NewIssue) => Task<Result<IssueView, ApiError>> {
        let content = (await Send(HttpMethod.Post, $"/api/projects/{projectId}/issues", Some(JsonSerializer.Serialize(issue, json))))?;
        Parsed(JsonSerializer.Deserialize<IssueView>(content, json))
    }

    /// Moves an issue through its workflow: `action` is the event's kind ("Start"), with its fields in `fields`.
    async fn Act(issueId: int, action: string, fields: Dictionary<string, string>) => Task<Result<IssueView, ApiError>> {
        let body: Dictionary<string, string> = ["kind": action, ...fields];
        let content = (await Send(HttpMethod.Post, $"/api/issues/{issueId}/events", Some(JsonSerializer.Serialize(body, json))))?;
        Parsed(JsonSerializer.Deserialize<IssueView>(content, json))
    }

    /// An issue's comments, oldest first.
    async fn Comments(issueId: int) => Task<Result<List<CommentView>, ApiError>> {
        let content = (await Send(HttpMethod.Get, $"/api/issues/{issueId}/comments", None))?;
        Parsed(JsonSerializer.Deserialize<List<CommentView>>(content, json))
    }

    async fn AddComment(issueId: int, text: string) => Task<Result<CommentView, ApiError>> {
        let content = (await Send(HttpMethod.Post, $"/api/issues/{issueId}/comments", Some(JsonSerializer.Serialize(NewComment(text), json))))?;
        Parsed(JsonSerializer.Deserialize<CommentView>(content, json))
    }

    /// Sends a request as the user; the body of a successful answer. It gives text, not a deserialized `T`: .NET's
    /// `Deserialize<T>` can give null for any T, which Piper can't see through a type parameter, so each caller
    /// deserializes to its own type, whose result Piper knows is optional.
    private async fn Send(method: HttpMethod, path: Url, body: string?) => Task<Result<string, ApiError>> {
        let request = HttpRequestMessage(method, path.ToUri());
        request.Headers.Add("X-User", user);
        if body is Some(text) {
            request.Content = StringContent(text, System.Text.Encoding.UTF8, "application/json");
        }
        try {
            let response = await http.SendAsync(request);
            let content = await response.Content.ReadAsStringAsync();
            if !response.IsSuccessStatusCode {
                return Err(ApiError((int)response.StatusCode, Problem(content) ?? response.ReasonPhrase ?? "failed"));
            }
            return Ok(content);
        } catch (e: HttpRequestException) {
            return Err(ApiError(0, $"Can't reach the API: {e.Message}"));
        }
    }

    /// A deserialized answer, or an error if the API answered with nothing (JSON `null`).
    private fn Parsed<T>(value: T?) => Result<T, ApiError> = match value {
        Some(v) => Ok(v),
        None => Err(ApiError(200, "The API answered with nothing.")),
    };

    /// What a ProblemDetails answer says: its detail, or its title.
    private fn Problem(content: string) => string? {
        try {
            let document = JsonDocument.Parse(content);
            for name in ["detail", "title"] {
                if document.RootElement.TryGetProperty(name, out let value) && value.ValueKind == JsonValueKind.String {
                    return value.GetString();
                }
            }
            return None;
        } catch (_: JsonException) {
            return None;
        }
    }
}
