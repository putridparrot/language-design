// What the window shows and does, without the window: [Notify] makes each property raise PropertyChanged, which data
// binding watches, and [Command] makes each action an ICommand a button binds to, enabled as its `Can…` says.
namespace TrackerDesktop;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

[Notify]
class MainViewModel(client: TrackerClient, user: string) {
    /// A view model that reads the issues again when the project or the status filter changes, and the comments when
    /// the issue does. (The search text waits for Refresh, rather than asking the API at each key.)
    static fn Create(client: TrackerClient, user: string) => MainViewModel {
        let model = MainViewModel(client, user);
        // Through the commands, which run the async methods: an event handler can't be an async lambda in Piper.
        model.PropertyChanged += (_, e) => {
            if e.PropertyName == "SelectedProjectIndex" || e.PropertyName == "StatusFilter" {
                model.RefreshCommand.Execute(None);
            } else if e.PropertyName == "SelectedIssueIndex" {
                model.LoadCommentsCommand.Execute(None);
            }
        };
        model
    }

    /// The projects, and the issues of the one chosen. Each read replaces the list, rather than changing an
    /// ObservableCollection item by item: a list control clears its selection when its items reset, after we've
    /// chosen the issue to show, and reuses its rows mid-change.
    prop Projects: List<Project> { get; set; } = [];
    prop Issues: List<IssueView> { get; set; } = [];

    /// Which project and issue are chosen, by position (-1 for none), as a list control's selection is.
    prop SelectedProjectIndex: int { get; set; } = -1;
    prop SelectedIssueIndex: int { get; set; } = -1;

    /// The filters: a status ("Any" for all) and words in the title.
    prop StatusFilter: string { get; set; } = "Any";
    prop SearchText: string { get; set; } = "";

    /// The new issue being written, and what an action needs: who's assigned, and why it's closed or rejected.
    prop NewTitle: string { get; set; } = "";
    prop NewDescription: string { get; set; } = "";
    prop NewPriority: string { get; set; } = "Normal";
    prop Assignee: string { get; set; } = user;
    prop Reason: string { get; set; } = "";

    /// The chosen issue's comments, and the one being written.
    prop Comments: List<CommentView> { get; set; } = [];
    prop NewComment: string { get; set; } = "";

    /// What happened last, or what went wrong.
    prop Message: string { get; set; } = "";

    prop SelectedProject => Project? = if SelectedProjectIndex >= 0 && SelectedProjectIndex < Projects.Count { Some(Projects[SelectedProjectIndex]) } else { None };
    prop SelectedIssue => IssueView? = if SelectedIssueIndex >= 0 && SelectedIssueIndex < Issues.Count { Some(Issues[SelectedIssueIndex]) } else { None };

    /// The chosen issue, described for the details pane.
    prop Details => string = match SelectedIssue {
        Some(i) => $"{i.title}\n\n{i.description}\n\nStatus: {i.status}   Priority: {i.priority}\nAssigned to: {i.assignee ?? "nobody"}\nResolution: {i.resolution ?? "-"}\nCan do next: {string.Join(", ", i.next)}",
        None => "Choose an issue.",
    };

    // Each workflow action is offered while the chosen issue's `next` names it.
    prop CanStart => bool = (SelectedIssue?.next.Contains("Start")) ?? false;
    prop CanSubmit => bool = (SelectedIssue?.next.Contains("Submit")) ?? false;
    prop CanUnassign => bool = (SelectedIssue?.next.Contains("Unassign")) ?? false;
    prop CanApprove => bool = (SelectedIssue?.next.Contains("Approve")) ?? false;
    prop CanReject => bool = (SelectedIssue?.next.Contains("Reject")) ?? false;
    prop CanClose => bool = (SelectedIssue?.next.Contains("Close")) ?? false;
    prop CanReopen => bool = (SelectedIssue?.next.Contains("Reopen")) ?? false;
    prop CanAddIssue => bool = SelectedProjectIndex >= 0 && NewTitle.Trim().Length > 0;
    prop CanAddComment => bool = SelectedIssueIndex >= 0 && NewComment.Trim().Length > 0;

    /// The comments, for the details pane: who wrote each, and when.
    prop CommentsText => string = if Comments.Count == 0 {
        "No comments yet."
    } else {
        string.Join("\n\n", Comments.Select(c => $"{c.author}, {c.created:yyyy-MM-dd HH:mm}:\n{c.text}"))
    };

    /// What a command threw, rather than an answer from the API (a bug, or the network failing mid-read): shown
    /// rather than lost, as an async command's exception would otherwise be.
    fn OnCommandFailed(command: string, error: Exception) {
        Message = $"{command} failed: {error.Message}";
    }

    [Command]
    async fn LoadAsync() {
        match await client.Projects() {
            Ok(found) => {
                Projects = found;
                if found.Count > 0 && SelectedProjectIndex < 0 { SelectedProjectIndex = 0; }
                await RefreshIssues();
            },
            Err(problem) => Message = problem.message,
        }
    }

    [Command]
    async fn RefreshAsync() { await RefreshIssues(); }

    [Command]
    async fn AddIssueAsync() {
        let Some(project) = SelectedProject else { return; };
        match await client.AddIssue(project.id, NewIssue(NewTitle.Trim(), NewDescription.Trim(), NewPriority)) {
            Ok(added) => {
                NewTitle = "";
                NewDescription = "";
                Message = $"Added {project.code}-{added.id}.";
                await RefreshIssues();
                Select(added.id);
            },
            Err(problem) => Message = problem.message,
        }
    }

    [Command] async fn StartAsync() { await Act("Start", ["assignee": Assignee]); }
    [Command] async fn SubmitAsync() { await Act("Submit", []); }
    [Command] async fn UnassignAsync() { await Act("Unassign", []); }
    [Command] async fn ApproveAsync() { await Act("Approve", []); }
    [Command] async fn RejectAsync() { await Act("Reject", ["reason": Reason]); }
    [Command] async fn CloseAsync() { await Act("Close", ["resolution": if Reason == "" { "closed" } else { Reason }]); }
    [Command] async fn ReopenAsync() { await Act("Reopen", []); }

    /// Reads the chosen issue's comments. An answer for an issue no longer chosen (the user moved on while it was on
    /// its way) is dropped.
    [Command]
    async fn LoadCommentsAsync() {
        let Some(issue) = SelectedIssue else {
            Comments = [];
            return;
        };
        match await client.Comments(issue.id) {
            Ok(found) => {
                if SelectedIssue is Some(still) && still.id == issue.id { Comments = found; }
            },
            Err(problem) => Message = problem.message,
        }
    }

    [Command]
    async fn AddCommentAsync() {
        let Some(issue) = SelectedIssue else { return; };
        match await client.AddComment(issue.id, NewComment.Trim()) {
            Ok(_) => {
                NewComment = "";
                Message = $"Commented on #{issue.id}.";
                await LoadCommentsAsync();
            },
            Err(problem) => Message = problem.message,
        }
    }

    /// Does `action` to the chosen issue, then shows it as it is now.
    async fn Act(action: string, fields: Dictionary<string, string>) {
        let Some(issue) = SelectedIssue else { return; };
        match await client.Act(issue.id, action, fields) {
            Ok(changed) => {
                Message = $"{action}: {changed.title} is {changed.status}.";
                await RefreshIssues();
                Select(changed.id);
            },
            Err(problem) => Message = problem.message,
        }
    }

    /// Reads the chosen project's issues again, through the filters.
    async fn RefreshIssues() {
        let Some(project) = SelectedProject else { return; };
        let status = if StatusFilter == "Any" { None } else { Some(StatusFilter) };
        let text = if SearchText.Trim() == "" { None } else { Some(SearchText.Trim()) };
        match await client.Issues(project.id, status, text) {
            Ok(found) => {
                Issues = found;
                SelectedIssueIndex = -1;
            },
            Err(problem) => Message = problem.message,
        }
    }

    /// Chooses the issue numbered `id`, if it's shown.
    fn Select(id: int) {
        SelectedIssueIndex = Issues.FindIndex(i => i.id == id);
    }
}
