namespace StockApp;

using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Builder;
using Piper.Actors.Remote;
using Piper.Runtime;

/// Three nodes in real time (PiperCluster), as the load runs real HTTP servers and clients against them.
async fn StartRealCluster() => Task<(PiperCluster, List<Shards>)> {
    let store = MemoryEventStore();
    let cluster = await PiperCluster.StartAsync(3, node => { Host(node, store); });
    (cluster, [...cluster.Nodes.Select(node => Shards(node))])
}

async test "the load run through every node's API reserves each unit exactly once" {
    let (nodes, cluster) = await StartRealCluster();
    let apps = cluster.Select(shards => StockServer(shards, "http://127.0.0.1:0")).ToList();
    for app in apps { await app.StartAsync(); }
    let urls: List<string> = [...apps.Select(app => app.Urls.First())];

    let report = await RunLoad(urls, "gear", 40, 150, 20);
    Assert(report.Exact(), Describe(report, "gear"));
    AssertEqual(110, report.Refused());
    AssertEqual(3, report.outcomes.Select(o => o.servedBy).Distinct().Count());
    AssertEqual(1, report.outcomes.Select(o => o.keptBy).Distinct().Count());

    // A quantity that makes no sense is refused before any actor is asked.
    using let http = HttpClient();
    let bad = await http.PostAsync($"{urls[0]}/stock/gear/reserve?quantity=0", None);
    AssertEqual(HttpStatusCode.BadRequest, bad.StatusCode);

    // Each node is live, and ready once its warehouse answers.
    for url in urls {
        AssertEqual("Healthy", await http.GetStringAsync($"{url}/healthz"));
        AssertEqual("Healthy", await http.GetStringAsync($"{url}/ready"));
    }

    for app in apps { await app.StopAsync(); }
    await nodes.StopAsync();
}
