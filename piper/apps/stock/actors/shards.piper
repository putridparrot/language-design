// Which node keeps each product, and reaching its actor there from any node.
namespace StockApp;

using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Piper.Runtime;
using Proto;
using Proto.Remote;
using Proto.Remote.GrpcNet;
using Piper.Actors.Remote;

/// Which of `count` nodes keeps `sku`. Every node lists the nodes in the same order, so they all agree. The hash is
/// FNV-1a over the code's bytes, not `string.GetHashCode`, which .NET seeds differently in each process.
fn OwnerIndex(sku: string, count: int) => int {
    mut hash = 2166136261L;
    for b in System.Text.Encoding.UTF8.GetBytes(sku) {
        hash = ((hash ^ b) * 16777619L) & 4294967295L;
    }
    (int)(hash % count)
}

/// Starts this node: an actor system the other nodes reach at `host:port`, hosting this node's warehouse, whose products
/// keep their events in `store` (PiperNode.StartAsync: a loopback host binds to it alone, and any other, a container's
/// or pod's name, binds to every interface and tells the others that name).
async fn StartNode(host: string, port: int, store: IEventStore) => Task<ActorSystem> {
    let system = await PiperNode.StartAsync(host, port);
    Warehouse.Spawn(system, "warehouse", system, store);
    system
}

/// A node as the dashboard shows it: whether it answered, and the products it keeps.
record NodeView(address: string, up: bool, products: List<Level>);

/// The products, as one node sees them: each kept by one of `nodes` (host:port, in the same order on every node), and
/// asked wherever that is, this node included.
class Shards(system: ActorSystem, nodes: List<string>) {
    /// The products whose actors this node knows have been started, so it asks the warehouse only the first time.
    let opened = ConcurrentDictionary<string, bool>();

    public let address: string = system.Address;

    fn Nodes() => List<string> = nodes;

    /// This node's actor system.
    fn Node() => ActorSystem = system;

    /// The node keeping `sku`.
    fn Owner(sku: string) => string = nodes[OwnerIndex(sku, nodes.Count)];

    /// What this node's warehouse has started.
    async fn Products() => Task<List<string>> = [...await Warehouse.Connect(system, address, "warehouse").Products()];

    /// Every node, asked at once, with the products it keeps: what the dashboard shows. A node that doesn't answer is
    /// shown as down (after two seconds) rather than failing the whole view.
    async fn Cluster() => Task<List<NodeView>> = [...await Task.WhenAll(nodes.Select(node => View(node)))];

    /// Asks `sku`'s actor, on its node. If the actor isn't there (its node restarted, losing it, as nothing stores
    /// the counts), it's started again, empty, and asked once more.
    async fn Ask<T>(sku: string, ask: (Product) => Task<T>) => Task<T> {
        try {
            return await ask(await Find(sku));
        } catch (_: DeadLetterException) {
            opened[sku] = false;
            return await ask(await Find(sku));
        }
    }

    /// One node: the products its warehouse has started, and each one's level.
    private async fn View(node: string) => Task<NodeView> {
        try {
            let skus = await Warehouse.Connect(system, node, "warehouse").WithTimeout(TimeSpan.FromSeconds(2)).Products();
            let levels = await Task.WhenAll(skus.Select(sku => Product.Connect(system, node, ProductName(sku)).WithTimeout(TimeSpan.FromSeconds(2)).Show()));
            return NodeView(node, true, [...levels]);
        } catch (_: Exception) {
            return NodeView(node, false, []);
        }
    }

    /// `sku`'s actor, started on its node if this node hasn't seen it started.
    private async fn Find(sku: string) => Task<Product> {
        let owner = Owner(sku);
        if !(opened.TryGetValue(sku, out let known) && known) {
            await Warehouse.Connect(system, owner, "warehouse").Open(sku);
            opened[sku] = true;
        }
        Product.Connect(system, owner, ProductName(sku))
    }
}
