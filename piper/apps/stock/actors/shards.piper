// The nodes as a cluster: which node keeps each product, and reaching its actor there from any node.
namespace StockApp;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Piper.Runtime;
using Piper.Actors.Remote;

/// Starts this node: an actor system the other nodes reach at `host:port` (PiperNode.StartAsync: a loopback host binds
/// to it alone, and any other, a container's or pod's name, binds to every interface and tells the others that name),
/// joined to the cluster `membership` lists, hosting the products, whose events are in `store`.
async fn StartNode(host: string, port: int, membership: IClusterMembership, store: IEventStore) => Task<ActorSystem> {
    let system = await PiperNode.StartAsync(host, port);
    await Cluster.JoinAsync(system, membership, "stock");
    Host(system, store);
    system
}

/// Makes `node` host products, each started on its owner as the first message for it arrives, carrying on from its
/// events in `store`; and its warehouse, which lists them. The nodes share the store, as a product moves between them.
fn Host(node: ActorSystem, store: IEventStore) {
    Product.HostInCluster(node.Cluster, (n, name, sku) => Product.Spawn(n, name, store, sku, n.Address));
    Warehouse.Spawn(node, "warehouse", node);
}

/// A node as the dashboard shows it: whether it answered, and the products it keeps.
record NodeView(address: string, up: bool, products: List<Level>);

/// The products, as one node sees them: each kept by the node of the cluster that owns it, and asked wherever that is,
/// this node included.
class Shards(system: ActorSystem) {
    public let address: string = system.Address;

    /// The nodes that are up, as this node sees them.
    fn Nodes() => List<string> = [...system.Cluster.Members];

    /// This node's actor system.
    fn Node() => ActorSystem = system;

    /// The node keeping `sku`: its owner in the cluster.
    fn Owner(sku: string) => string = system.Cluster.OwnerOf(ProductName(sku));

    /// The products running on this node.
    fn Products() => Task<List<string>> = Task.FromResult<List<string>>([...system.Cluster.Hosted("Product").Order()]);

    /// Every node this one knows of, asked at once, with the products it keeps: what the dashboard shows. A node that
    /// doesn't answer is shown as down (after two seconds) rather than failing the whole view.
    async fn Cluster() => Task<List<NodeView>> = [...await Task.WhenAll(system.Cluster.Known.Select(node => View(node)))];

    /// Asks `sku`'s actor, on its owner: the cluster starts it there, from its events, if it isn't running, and asks
    /// again if it's moving between nodes.
    async fn Ask<T>(sku: string, ask: (Product) => Task<T>) => Task<T> = await ask(Product.InCluster(system, sku));

    /// One node: the products running on it, and each one's level.
    private async fn View(node: string) => Task<NodeView> {
        try {
            let skus = await Warehouse.Connect(system, node, "warehouse").WithTimeout(TimeSpan.FromSeconds(2)).Products();
            let levels = await Task.WhenAll(skus.Select(sku => Product.Connect(system, node, ProductName(sku)).WithTimeout(TimeSpan.FromSeconds(2)).Show()));
            return NodeView(node, true, [...levels]);
        } catch (_: Exception) {
            return NodeView(node, false, []);
        }
    }
}
