// The actors: a product's stock, and the warehouse on each node that starts the products it keeps.
namespace StockApp;

using System.Collections.Immutable;
using Proto;

/// How much of a product there is, and the node keeping its count.
record Level(sku: string, onHand: int, reserved: int, node: string);

/// The answer to a reservation: whether it was granted, how many are left, and the node that decided.
record Reservation(sku: string, granted: bool, left: int, node: string);

/// One product's stock. Its count lives only here, and it handles one message at a time, so reservations arriving
/// from every node at once can't oversell it: no locks, and no database transaction.
actor Product(sku: string, node: string) {
    mut onHand = 0;
    mut reserved = 0;

    on Receive(quantity: int) => Level {
        onHand += quantity;
        Level(sku, onHand, reserved, node)
    }

    on Reserve(quantity: int) => Reservation {
        if quantity > onHand {
            Reservation(sku, false, onHand, node)
        } else {
            onHand -= quantity;
            reserved += quantity;
            Reservation(sku, true, onHand, node)
        }
    }

    on Show() => Level { Level(sku, onHand, reserved, node) }
}

/// Every node hosts one, named "warehouse". It starts each product this node keeps the first time it's asked for, so
/// a product's actor exists once, on its node, however many nodes ask at the same moment.
actor Warehouse(host: ActorSystem) {
    mut skus = ImmutableSortedSet.Create<string>();

    on Open(sku: string) => bool {
        if !skus.Contains(sku) {
            Product.Spawn(host, ProductName(sku), sku, host.Address);
            skus = skus.Add(sku);
        }
        true
    }

    on Products() => ImmutableList<string> { skus.ToImmutableList() }
}

/// The name a product's actor has on its node.
fn ProductName(sku: string) => string = $"product-{sku}";
