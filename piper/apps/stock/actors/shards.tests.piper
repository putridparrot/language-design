namespace StockApp;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Piper.Actors.Remote;
using Piper.Runtime;

/// Three nodes in a simulated cluster (Piper.Actors.Remote's SimulatedCluster), sharing one store of events in memory,
/// as three pods sharing a database would: their pings, timeouts and messages on the simulation's clock and network, so
/// the tests take no real time and don't depend on how busy the machine is, and each runs over several seeds.
async fn StartNodes() => Task<SimulatedCluster> {
    let store = MemoryEventStore();
    await SimulatedCluster.StartAsync(3, node => { Host(node, store); }, NetworkFaults.None)
}

/// Each node's view of the products.
fn Sharded(cluster: SimulatedCluster) => List<Shards> = [...Enumerable.Range(0, cluster.Count).Select(i => Shards(cluster[i]))];

async fn StartCluster() => Task<List<Shards>> = Sharded(await StartNodes());

async test "a node cut off from the others shows as down, its products served by the rest meanwhile, and as up again once it's back" simulate runs 10 {
    let cluster = await StartNodes();
    let shards = Sharded(cluster);
    let level = await shards[0].Ask("bolt", p => p.Receive(5));
    let owner = [...cluster.Addresses].IndexOf(level.node);
    let other = (owner + 1) % 3;

    cluster.Isolate(owner);
    Assert(await cluster.WaitForMembersAsync(other, 2), "the others see it gone");
    let split = await shards[other].Cluster();
    AssertEqual(3, split.Count);
    AssertEqual(2, split.Count(v => v.up));
    Assert(!split.Single(v => v.address == level.node).up);
    let moved = await shards[other].Ask("bolt", p => p.Show());
    AssertEqual(5, moved.onHand);
    Assert(moved.node != level.node);

    cluster.Heal();
    Assert(await cluster.SettleAsync(), "they agree again");
    let healed = await shards[other].Cluster();
    Assert(healed.All(v => v.up));
    AssertEqual(5, healed.Single(v => v.address == level.node).products.Single().onHand);
}

async test "a node cut off while the others change its products shows their changes once it's back" simulate runs 10 {
    let cluster = await StartNodes();
    let shards = Sharded(cluster);
    let level = await shards[0].Ask("bolt", p => p.Receive(10));
    let owner = [...cluster.Addresses].IndexOf(level.node);
    let other = (owner + 1) % 3;

    // Cut off, the owner keeps its copy of the product; the others start one of their own, which reserves three.
    cluster.Isolate(owner);
    Assert(await cluster.WaitForMembersAsync(other, 2), "the others see it gone");
    let reservation = await shards[other].Ask("bolt", p => p.Reserve(3));
    Assert(reservation.granted);
    Assert(reservation.node != level.node);

    // Back, the owner's copy from before mustn't answer: it starts again, from what was saved meanwhile.
    cluster.Heal();
    Assert(await cluster.SettleAsync(), "they agree again");
    let after = await shards[owner].Ask("bolt", p => p.Show());
    AssertEqual(level.node, after.node);
    AssertEqual(7, after.onHand);
    AssertEqual(3, after.reserved);
}

async test "every node picks the same owner for a product, and products spread over the nodes" simulate runs 5 {
    let cluster = await StartCluster();
    let skus = [...Enumerable.Range(0, 300).Select(i => $"sku-{i}")];
    Assert(skus.All(sku => cluster[0].Owner(sku) == cluster[1].Owner(sku) && cluster[1].Owner(sku) == cluster[2].Owner(sku)));
    let counts = skus.GroupBy(sku => cluster[0].Owner(sku)).ToDictionary(g => g.Key, g => g.Count());
    AssertEqual(3, counts.Count);
    Assert(counts.Values.All(n => n > 60), string.Join(", ", counts.Values));
}

async test "a product is kept by one node, whichever node asks" simulate runs 10 {
    let cluster = await StartCluster();
    let level = await cluster[0].Ask("bolt", p => p.Receive(5));
    AssertEqual(cluster[0].Owner("bolt"), level.node);
    for shards in cluster {
        AssertEqual(5, (await shards.Ask("bolt", p => p.Show())).onHand);
    }
    let owner = cluster.First(s => s.address == level.node);
    AssertEqual("bolt", (await owner.Products()).Single());
    mut kept = 0;
    for shards in cluster {
        kept += (await shards.Products()).Count;
    }
    AssertEqual(1, kept);
}

async test "any node shows every node, each with the products it keeps" simulate runs 10 {
    let cluster = await StartCluster();
    for sku in ["bolt", "gear", "nut", "washer"] {
        await cluster[0].Ask(sku, p => p.Receive(3));
    }
    let views = await cluster[2].Cluster();
    AssertEqual(3, views.Count);
    Assert(views.All(v => v.up));
    AssertEqual(4, views.Sum(v => v.products.Count));
    for view in views {
        Assert(view.products.All(p => p.node == view.address && p.onHand == 3 && cluster[0].Owner(p.sku) == view.address));
    }
}

async test "a node that leaves hands its products to the others, with their counts" simulate runs 10 {
    let cluster = await StartNodes();
    let shards = Sharded(cluster);
    let skus = [...Enumerable.Range(0, 12).Select(i => $"part-{i}")];
    for sku in skus {
        await shards[0].Ask(sku, p => p.Receive(7));
    }
    let leaving = [...cluster.Addresses].IndexOf(shards[0].Owner(skus[0]));
    let staying = (leaving + 1) % 3;
    await cluster.StopAsync(leaving);
    Assert(await cluster.WaitForMembersAsync(staying, 2), "the others see it gone");
    for sku in skus {
        let level = await shards[staying].Ask(sku, p => p.Reserve(1));
        AssertEqual(6, level.left);
        Assert(level.node != cluster.Addresses[leaving]);
    }
}

async test "reservations from every node at once never oversell" simulate runs 10 {
    let cluster = await StartCluster();
    await cluster[0].Ask("widget", p => p.Receive(50));
    let reservations = await Task.WhenAll(Enumerable.Range(0, 200).Select(i => cluster[i % 3].Ask("widget", p => p.Reserve(1))));
    AssertEqual(50, reservations.Count(r => r.granted));
    let level = await cluster[1].Ask("widget", p => p.Show());
    AssertEqual(0, level.onHand);
    AssertEqual(50, level.reserved);
}

/// Reserves one of `sku` from node `from` after a while (if it's up): whether the reservation was answered, granted.
async fn ReserveLater(cluster: SimulatedCluster, from: int, after: TimeSpan, sku: string) => Task<bool> {
    await Task.Delay(after);
    mut granted = false;
    if cluster.IsUp(from) {
        try {
            granted = (await Shards(cluster[from]).Ask(sku, p => p.Reserve(1))).granted;
        } catch (e: Exception) {
            // Lost, timed out, or its node went down: whether it was reserved isn't known.
        }
    }
    granted
}

async test "no product is oversold, whatever the network and the nodes do" simulate runs 40 {
    let store = MemoryEventStore();
    let cluster = await SimulatedCluster.StartAsync(3, node => { Host(node, store); }, NetworkFaults.None);
    await Shards(cluster[0]).Ask("bolt", p => p.Receive(10));

    // Thirty reservations of ten bolts, from any node, over twelve seconds, on a network losing one message in twenty,
    // while the run crashes and restarts nodes, and cuts them off and heals the network, as it chooses.
    cluster.Network.Faults = NetworkFaults.Lossy(0.05);
    cluster.StartChaos();
    let random = PiperSimulation.Running.Random;
    let reservations = [...Enumerable.Range(0, 30).Select(i =>
        ReserveLater(cluster, random.Next(3), TimeSpan.FromMilliseconds(random.Next(12_000)), "bolt"))];
    let granted = (await Task.WhenAll(reservations)).Count(answered => answered);

    cluster.Network.Faults = NetworkFaults.None;
    Assert(await cluster.CalmAsync(), "every node back, and agreeing on the members");
    let level = await Shards(cluster[2]).Ask("bolt", p => p.Show());
    PiperSimulation.Running.Log($"granted {granted}: {level}");
    Assert(level.onHand >= 0, "never oversold");
    AssertEqual(10, level.onHand + level.reserved);
    Assert(granted <= level.reserved, "every reservation granted was kept");
}
