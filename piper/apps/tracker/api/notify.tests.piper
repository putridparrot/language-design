namespace Tracker;

using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Http;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Data.Sqlite;
using Piper.Messaging;

/// A webhook that fails its first `failures` calls, then succeeds, recording what it was sent.
class FlakyWebhook(failures: int): HttpMessageHandler {
    public mut calls = 0;
    public let bodies: List<string> = [];

    override async fn SendAsync(request: HttpRequestMessage, cancellationToken: CancellationToken) => Task<HttpResponseMessage> {
        calls += 1;
        if request.Content is Some(content) {
            bodies.Add(await content.ReadAsStringAsync(cancellationToken));
        }
        HttpResponseMessage(if calls <= failures { HttpStatusCode.ServiceUnavailable } else { HttpStatusCode.OK })
    }
}

fn SomeView() => IssueView = View(NewBug());

/// A database in memory with one issue, "Crash on save", that the webhook consumer can open by its settings (shared
/// by name, and kept by `keepAlive`), and a bus whose retries come quickly, for a test.
async fn WebhookSetup() => Task<(Settings, SqliteConnection, Bus, MemoryTransport)> {
    let connection = $"Data Source=file:notify-{Guid.NewGuid()}?mode=memory&cache=shared";
    let keepAlive = SqliteConnection(connection);
    await keepAlive.OpenAsync();
    let settings = Settings(connection, 60, None);
    await Prepare(settings);
    using let db = Open(settings);
    db.Projects.Add(Project(ProjectId(0), "WEB", "Website"));
    await db.SaveChangesAsync();
    let _ = await AddIssue(db, ProjectId(1), NewIssue("Crash on save", "", Priority.High), Noon());
    let transport = MemoryTransport();
    (settings, keepAlive, Bus(transport, BusOptions() { Attempts: 3, Backoff: TimeSpan.FromMilliseconds(5) }), transport)
}

async test "a webhook that's briefly down is tried again" {
    let webhook = FlakyWebhook(2);
    await WebhookNotifier(HttpClient(webhook), "http://hooks.test/issues").IssueChanged(SomeView());
    AssertEqual(3, webhook.calls);
    Assert(webhook.bodies[2].Contains("\"title\":\"Crash on save\""), webhook.bodies[2]);
}

async test "an issue changing is posted to the webhook, as it is when it's sent" {
    let (settings, keepAlive, bus, transport) = await WebhookSetup();
    let webhook = FlakyWebhook(0);
    await using let consumer = await Webhook(settings, WebhookNotifier(HttpClient(webhook), "http://hooks.test/issues")).Start(bus);
    await bus.Publish(IssueChanged(IssueId(1)));
    await transport.Idle();
    AssertEqual(1, webhook.calls);
    Assert(webhook.bodies[0].Contains("\"title\":\"Crash on save\""), webhook.bodies[0]);
    keepAlive.Dispose();
}

async test "a webhook that stays down is retried by the bus, then dead-lettered, and the change stands" {
    let (settings, keepAlive, bus, transport) = await WebhookSetup();
    let webhook = FlakyWebhook(100);
    await using let consumer = await Webhook(settings, WebhookNotifier(HttpClient(webhook), "http://hooks.test/issues")).Start(bus);
    await bus.Publish(IssueChanged(IssueId(1)));
    await transport.Idle();
    AssertEqual(9, webhook.calls);                    // three deliveries, each tried three times at once
    AssertEqual(1, transport.DeadLetters.Count);
    keepAlive.Dispose();
}

async test "a notification for an issue that's gone is rejected, not retried" {
    let (settings, keepAlive, bus, transport) = await WebhookSetup();
    let webhook = FlakyWebhook(0);
    await using let consumer = await Webhook(settings, WebhookNotifier(HttpClient(webhook), "http://hooks.test/issues")).Start(bus);
    await bus.Publish(IssueChanged(IssueId(99)));
    await transport.Idle();
    AssertEqual(0, webhook.calls);
    AssertEqual("There's no issue 99.", transport.DeadLetters[0].Reason);
    keepAlive.Dispose();
}

test "the settings choose the notifier" {
    Assert(NotifierFor(Settings("Data Source=:memory:", 60, None)) is _: NoNotifier);
    Assert(NotifierFor(Settings("Data Source=:memory:", 60, Some(Piper.Runtime.Secret<string>("http://hooks.test")))) is _: WebhookNotifier);
}
