namespace Tracker;

using System;
using System.Linq;
using System.Net.Http;
using System.Text;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Builder;
using Microsoft.Data.Sqlite;
using Piper.Web;

/// A running tracker for a test: the app, served from memory, with its own in-memory database (kept alive by
/// `keepAlive`, as SQLite drops a shared in-memory database when its last connection closes), and a client calling it.
record Running(client: TestClient<WebApplication>, keepAlive: SqliteConnection);

async fn StartTracker(searchesPerMinute: int) => Task<Running> = await StartTrackerTelling(searchesPerMinute, NoNotifier());

/// The same, telling `notifier` of changed issues.
async fn StartTrackerTelling(searchesPerMinute: int, notifier: Notifier) => Task<Running> {
    let connection = $"Data Source=file:tracker-{Guid.NewGuid()}?mode=memory&cache=shared";
    let keepAlive = SqliteConnection(connection);
    await keepAlive.OpenAsync();
    let settings = Settings(connection, searchesPerMinute);
    Prepare(settings);
    let client = await TestClient.Start(() => TrackerServer(settings, FixedClock(Noon()), notifier, ""));
    Running(client, keepAlive)
}

/// Stops the app (disposing its client does) and closes the database.
fn Stop(running: Running) {
    running.client.Dispose();
    running.keepAlive.Dispose();
}

/// Calls the tracker as `user` (with `roles`, comma-separated), sending `json` if there is any; the status and body.
async fn Call(running: Running, method: string, path: string, user: string, roles: string, json: string) => Task<(int, string)> {
    let request = HttpRequestMessage(HttpMethod(method), path);
    if user != "" { request.Headers.Add("X-User", user); }
    if roles != "" { request.Headers.Add("X-Roles", roles); }
    if json != "" { request.Content = StringContent(json, Encoding.UTF8, "application/json"); }
    let response = await running.client.SendAsync(request);
    ((int)response.StatusCode, await response.Content.ReadAsStringAsync())
}

async fn Get(running: Running, path: string) => Task<(int, string)> = await Call(running, "GET", path, "ada", "", "");

async fn Post(running: Running, path: string, json: string) => Task<(int, string)> = await Call(running, "POST", path, "ada", "", json);

async fn AddWebProject(running: Running) {
    let (status, _) = await Call(running, "POST", "/api/projects", "root", "admin", """{"code": "WEB", "name": "Website"}""");
    AssertEqual(200, status);
}

async test "the API needs a signed-in user, except for its health" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    AssertEqual(200, (await Call(running, "GET", "/api/health", "", "", "")).Item1);
    AssertEqual(401, (await Call(running, "GET", "/api/projects", "", "", "")).Item1);
    AssertEqual(200, (await Get(running, "/api/projects")).Item1);
}

async test "liveness and readiness need no sign-in, and readiness checks the database" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    AssertEqual((200, "Healthy"), await Call(running, "GET", "/healthz", "", "", ""));
    AssertEqual((200, "Healthy"), await Call(running, "GET", "/ready", "", "", ""));
}

async test "only admins make projects, and codes are checked" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    AssertEqual(403, (await Post(running, "/api/projects", """{"code": "WEB", "name": "Website"}""")).Item1);
    await AddWebProject(running);
    let (lower, _) = await Call(running, "POST", "/api/projects", "root", "admin", """{"code": "web", "name": "Website"}""");
    AssertEqual(400, lower);
    let (twice, body) = await Call(running, "POST", "/api/projects", "root", "admin", """{"code": "WEB", "name": "Again"}""");
    AssertEqual(400, twice);
    Assert(body.Contains("There's already a project WEB"), body);
}

async test "an issue moves through its workflow over HTTP" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    await AddWebProject(running);

    let (created, issue) = await Post(running, "/api/projects/1/issues", """{"title": "Crash on save", "description": "", "priority": "High"}""");
    AssertEqual(200, created);
    Assert(issue.Contains("\"status\":\"Open\""), issue);
    Assert(issue.Contains("\"next\":[\"Start\",\"Close\"]"), issue);

    let (started, view) = await Post(running, "/api/issues/1/events", """{"kind": "Start", "assignee": "ada"}""");
    AssertEqual(200, started);
    Assert(view.Contains("\"assignee\":\"ada\""), view);

    // The workflow refuses what the status doesn't allow, as a 409 naming the action.
    let (refused, problem) = await Post(running, "/api/issues/1/events", """{"kind": "Approve"}""");
    AssertEqual(409, refused);
    Assert(problem.Contains("\"action\":\"Approve\"") && problem.Contains("\"current\":\"InProgress\""), problem);

    AssertEqual(404, (await Get(running, "/api/issues/99")).Item1);
    AssertEqual(404, (await Post(running, "/api/issues/99/events", """{"kind": "Submit"}""")).Item1);
}

async test "a post retried with its Idempotency-Key adds one issue, and is answered as the first was" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    await AddWebProject(running);
    async fn Add(key: string) => Task<(int, string)> {
        let request = HttpRequestMessage(HttpMethod.Post, "/api/projects/1/issues");
        request.Headers.Add("X-User", "ada");
        request.Headers.Add("Idempotency-Key", key);
        request.Content = StringContent("""{"title": "Crash on save", "description": "", "priority": "High"}""", Encoding.UTF8, "application/json");
        let response = await running.client.SendAsync(request);
        ((int)response.StatusCode, await response.Content.ReadAsStringAsync())
    }
    let first = await Add("retry-1");
    AssertEqual(200, first.Item1);
    AssertEqual(first, await Add("retry-1"));
    let (_, issues) = await Get(running, "/api/projects/1/issues");
    AssertEqual(1, issues.Split("Crash on save").Length - 1);
    // A new key is a new request.
    AssertEqual(200, (await Add("retry-2")).Item1);
}

async test "a request breaking an invariant is a 400" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    await AddWebProject(running);
    AssertEqual(400, (await Post(running, "/api/projects/1/issues", """{"title": "  ", "description": "", "priority": "Low"}""")).Item1);
    AssertEqual(404, (await Post(running, "/api/projects/7/issues", """{"title": "Lost", "description": "", "priority": "Low"}""")).Item1);
}

async test "comments record who wrote them" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    await AddWebProject(running);
    let _ = await Post(running, "/api/projects/1/issues", """{"title": "Crash on save", "description": "", "priority": "High"}""");
    AssertEqual(200, (await Call(running, "POST", "/api/issues/1/comments", "alan", "", """{"text": "Seen it too"}""")).Item1);
    let (_, comments) = await Get(running, "/api/issues/1/comments");
    Assert(comments.Contains("\"author\":\"alan\""), comments);
}

async test "search filters by status, and is limited per minute" {
    let running = await StartTracker(2);
    defer { Stop(running); }
    await AddWebProject(running);
    for title in ["Crash on save", "Typo"] {
        let _ = await Post(running, "/api/projects/1/issues", $$"""{"title": "{{title}}", "description": "", "priority": "Normal"}""");
    }
    let _ = await Post(running, "/api/issues/2/events", """{"kind": "Close", "resolution": "fixed"}""");

    let (open, found) = await Get(running, "/api/projects/1/issues?status=Open");
    AssertEqual(200, open);
    Assert(found.Contains("Crash on save") && !found.Contains("Typo"), found);
    let (bad, problem) = await Get(running, "/api/projects/1/issues?status=Done");
    AssertEqual(400, bad);
    Assert(problem.Contains("isn't a status: Open, InProgress, InReview, Closed"), problem);
    AssertEqual(429, (await Get(running, "/api/projects/1/issues")).Item1);
}

/// The typed client apps/tracker-core's `api TrackerApi` generates, which apps/tracker-desktop uses, against the real
/// server: its records, newtypes and enums go over the wire and back, and the server's errors come back as IssueErrors.
async test "the API's own client works with the server" {
    let running = await StartTracker(60);
    defer { Stop(running); }
    running.client.DefaultRequestHeaders.Add("X-User", "root");
    running.client.DefaultRequestHeaders.Add("X-Roles", "admin");
    let api = TrackerApi(running.client);

    AssertEqual(Ok("ok"), await api.Health());
    let Ok(web) = await api.AddProject(NewProject("WEB", "Website")) else { Assert(false, "adding the project failed"); return; };
    let Ok(issue) = await api.AddIssue(web.id, NewIssue("Crash on save", "Every time.", Priority.High)) else { Assert(false, "adding the issue failed"); return; };
    AssertEqual(WorkflowState.Open, issue.status);
    AssertEqual(["Start", "Close"], issue.next);

    let Ok(started) = await api.Act(issue.id, WorkflowEvent.Start("ada")) else { Assert(false, "starting failed"); return; };
    AssertEqual(Some("ada"), started.assignee);
    let Err(refused) = await api.Act(issue.id, WorkflowEvent.Approve) else { Assert(false, "an in-progress issue was approved"); return; };
    AssertEqual(409, refused.Status);
    AssertEqual(Some(IssueError.NotAllowed("Approve", WorkflowState.InProgress)), refused.Error);

    let Ok(found) = await api.Issues(web.id, Some("InProgress"), None) else { Assert(false, "searching failed"); return; };
    AssertEqual([issue.id], found.ConvertAll(i => i.id));
    let Err(badStatus) = await api.Issues(web.id, Some("Lost"), None) else { Assert(false, "a made-up status was searched for"); return; };
    AssertEqual(400, badStatus.Status);

    let Ok(_) = await api.AddComment(issue.id, NewComment("On it.")) else { Assert(false, "commenting failed"); return; };
    let Ok(comments) = await api.Comments(issue.id) else { Assert(false, "reading comments failed"); return; };
    AssertEqual(["root: On it."], comments.ConvertAll(c => $"{c.author}: {c.text}"));

    let Ok(missing) = await api.Issue(IssueId(99)) else { Assert(false, "a missing issue wasn't None"); return; };
    Assert(missing is None);
    let Err(noProject) = await api.AddIssue(ProjectId(99), NewIssue("Lost", "", Priority.Low)) else { Assert(false, "an issue was added to no project"); return; };
    AssertEqual(Some(IssueError.NoProject(ProjectId(99))), noProject.Error);
}

/// Records each issue it's told of, as a webhook would be sent it.
class RecordingNotifier: Notifier {
    public let told = System.Collections.Concurrent.ConcurrentQueue<IssueView>();

    fn IssueChanged(issue: IssueView) => Task {
        told.Enqueue(issue);
        Task.CompletedTask
    }
}

async test "a transition over HTTP reaches the webhook, through the outbox" {
    let notifier = RecordingNotifier();
    let running = await StartTrackerTelling(60, notifier);
    defer { Stop(running); }
    await AddWebProject(running);
    let _ = await Post(running, "/api/projects/1/issues", """{"title": "Crash on save", "description": "", "priority": "High"}""");
    let (started, _) = await Post(running, "/api/issues/1/events", """{"kind": "Start", "assignee": "ada"}""");
    AssertEqual(200, started);

    // Saved with the change, then sent by the app's relay and posted by its consumer, in the background.
    let deadline = DateTime.UtcNow.AddSeconds(10);
    while notifier.told.IsEmpty && DateTime.UtcNow < deadline {
        await Task.Delay(20);
    }
    let told = notifier.told.ToArray();
    AssertEqual(1, told.Length);
    AssertEqual(IssueId(1), told[0].id);
    AssertEqual(WorkflowState.InProgress, told[0].status);
}
