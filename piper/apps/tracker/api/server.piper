// Starting the tracker: its services, sign-in, and the web app.
namespace Tracker;

using System;
using System.Net.Http;
using System.Security.Claims;
using System.Text.Encodings.Web;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

/// Sign-in for development and tests: the `X-User` header names the user, and `X-Roles` lists their roles
/// (`X-Roles: admin`). A real deployment would use cookies or JWT bearer tokens instead.
class HeaderAuthentication(options: IOptionsMonitor<AuthenticationSchemeOptions>, logger: ILoggerFactory, encoder: UrlEncoder)
    : AuthenticationHandler<AuthenticationSchemeOptions>(options, logger, encoder) {

    public static let Scheme = "Header";

    override fn HandleAuthenticateAsync() => Task<AuthenticateResult> = Task.FromResult(Authenticate());

    fn Authenticate() => AuthenticateResult {
        let user = Request.Headers["X-User"].ToString();
        if user == "" {
            return AuthenticateResult.NoResult();
        }
        let identity = ClaimsIdentity(HeaderAuthentication.Scheme);
        identity.AddClaim(Claim(ClaimTypes.Name, user));
        for role in Request.Headers["X-Roles"].ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) {
            identity.AddClaim(Claim(ClaimTypes.Role, role));
        }
        AuthenticateResult.Success(AuthenticationTicket(ClaimsPrincipal(identity), HeaderAuthentication.Scheme))
    }
}

/// The web app, set up but not started: `Main` runs it, and the tests serve it from memory. Becomes
/// `fn TrackerServer(settings, clock, notifier, urls) => WebApplication`, with its middleware in the order ASP.NET Core
/// needs (the policies' before the endpoints).
server TrackerServer(settings: Settings, clock: Clock, notifier: Notifier, urls: string) {
    urls urls;
    logging off;

    // One database context per request, as EF Core expects.
    scoped TrackerDb = TrackerDb(DbContextOptionsBuilder<TrackerDb>().UseSqlite(settings.connection).Options);
    singleton Clock = clock;
    singleton Notifier = notifier;

    policies Security(settings);
    // Sign-in is the app's choice, so it's written against the builder.
    configure {
        builder.Services.AddAuthentication(HeaderAuthentication.Scheme)
            .AddScheme<AuthenticationSchemeOptions, HeaderAuthentication>(HeaderAuthentication.Scheme, options => {});
    }
    problems;
    endpoints Api;

    // /healthz while the process runs; /ready when the database answers too.
    health "/healthz" ready "/ready" {
        check "database" async (db: TrackerDb) => await db.Database.CanConnectAsync();
    }
}

/// Makes the database's tables, if they aren't there.
async fn Prepare(settings: Settings) {
    using let db = TrackerDb(DbContextOptionsBuilder<TrackerDb>().UseSqlite(settings.connection).Options);
    await db.Database.EnsureCreatedAsync();
}

/// The notifier the settings ask for: a webhook, or no one.
fn NotifierFor(settings: Settings) => Notifier = match settings.webhook {
    Some(url) => WebhookNotifier(HttpClient(), url),
    None => NoNotifier(),
};
