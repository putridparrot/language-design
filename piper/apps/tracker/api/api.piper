// The tracker's HTTP API: its settings, services, who may call what, and the endpoints.
namespace Tracker;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Security.Claims;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

/// The tracker's settings, from the "Tracker" section of appsettings.json or the environment (Tracker__Connection).
config Settings from "Tracker" {
    connection: string = "Data Source=tracker.db";
    searchesPerMinute: int = 60 requires searchesPerMinute > 0;
    secret webhook: string?;                // where to post changed issues, if anywhere: a secret, as its URL carries its token
}

/// The time now: a service, so tests can fix it.
trait Clock {
    fn Now() => DateTime;
}

record SystemClock();

extend SystemClock: Clock {
    fn Now() => DateTime = DateTime.UtcNow;
}

record FixedClock(time: DateTime);

extend FixedClock: Clock {
    fn Now() => DateTime = this.time;
}

fn View(issue: Issue) => IssueView = IssueView(
    issue.id, issue.projectId, issue.title, issue.description, issue.priority, issue.status,
    issue.assignee, issue.resolution, Utc(issue.created), Utc(issue.updated), Workflow.Resume(issue.status, issue).Events);

/// A time the tracker stored, which is always UTC: SQLite keeps it as text without saying so, so it comes back unmarked.
fn Utc(time: DateTime) => DateTime = DateTime.SpecifyKind(time, DateTimeKind.Utc);

/// Who may do what: anyone signed in works with issues; admins make projects; searching is limited per minute, as
/// the settings say.
policies Security(settings: Settings) {
    authorize "admin" roles "admin";
    ratelimit "search" fixed settings.searchesPerMinute per minute;
}

endpoints Api: TrackerApi "/api" authorize {
    get "/health" anonymous () => "ok";

    get "/projects" async (db: TrackerDb) => await db.Projects.OrderBy(p => p.code).ToListAsync();
    post "/projects" authorize "admin" async (project: NewProject, db: TrackerDb) => await AddProject(db, project);

    get "/projects/{projectId:int}/issues" ratelimit "search" async (projectId: ProjectId, status: string?, q: string?, db: TrackerDb) =>
        await SearchViews(db, projectId, status, q);
    post "/projects/{projectId:int}/issues" async (projectId: ProjectId, issue: NewIssue, db: TrackerDb, clock: Clock) =>
        await AddIssue(db, projectId, issue, clock.Now()) ?> View;

    get "/issues/{id:int}" async (id: IssueId, db: TrackerDb) => await FindIssue(db, id) ?> View;
    post "/issues/{id:int}/events" async (id: IssueId, event: WorkflowEvent, db: TrackerDb, clock: Clock, notifier: Notifier, log: ILogger<Notifier>) => {
        let result = await Transition(db, id, event, clock.Now()) ?> View;
        if result is Ok(view) { await Notify(notifier, view, log); }
        result
    }

    get "/issues/{id:int}/comments" async (id: IssueId, db: TrackerDb) => await CommentsOn(db, id);
    post "/issues/{id:int}/comments" async (id: IssueId, comment: NewComment, user: ClaimsPrincipal, db: TrackerDb, clock: Clock) =>
        await AddComment(db, id, user.Identity?.Name ?? "someone", comment.text, clock.Now());
}

async fn AddProject(db: TrackerDb, request: NewProject) => Task<Result<Project, IssueError>> {
    if await db.Projects.AnyAsync(p => p.code == request.code) {
        return Err(IssueError.Invalid($"There's already a project {request.code}."));
    }
    let project = Project(ProjectId(0), request.code, request.name.Trim());
    db.Projects.Add(project);
    await db.SaveChangesAsync();
    Ok(project)
}

async fn SearchViews(db: TrackerDb, projectId: ProjectId, status: string?, text: string?) => Task<Result<List<IssueView>, IssueError>> {
    let wanted = ParseStatus(status)?;
    Ok((await Search(db, projectId, wanted, text)).Select(View).ToList())
}

/// A status filter from the query string, `?status=InProgress`, if there's one.
fn ParseStatus(text: string?) => Result<WorkflowState?, IssueError> = match text {
    None => Ok(None),
    Some(name) => match WorkflowState.Parse(name) {
        Some(status) => Ok(Some(status)),
        None => Err(IssueError.Invalid($"'{name}' isn't a status: {string.Join(", ", WorkflowState.Values)}.")),
    },
};
