namespace Tracker;

using System;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using Piper.Data;
using Piper.Messaging;

/// An empty in-memory database with one project, "WEB".
async fn TestDatabase() => Task<TrackerDb> {
    let db = await OpenDatabase("Data Source=:memory:");
    db.Projects.Add(Project(ProjectId(0), "WEB", "Website"));
    await db.SaveChangesAsync();
    db
}

async test "issues are numbered and stored" {
    using let db = await TestDatabase();
    let first = await AddIssue(db, ProjectId(1), NewIssue("Crash on save", "", Priority.High), Noon());
    let second = await AddIssue(db, ProjectId(1), NewIssue("Typo", "", Priority.Low), Noon());
    match (first, second) {
        (Ok(a), Ok(b)) => {
            AssertEqual(IssueId(1), a.id);
            AssertEqual(IssueId(2), b.id);
        },
        _ => Assert(false, "both should have been added"),
    }
    db.ChangeTracker.Clear();
    let found = await FindIssue(db, IssueId(2));
    AssertEqual(Some("Typo"), found?.title);
}

async test "an issue for a missing project is refused" {
    using let db = await TestDatabase();
    let result = await AddIssue(db, ProjectId(99), NewIssue("Lost", "", Priority.Low), Noon());
    Assert(result is Err(IssueError.NoProject(ProjectId(99))));
}

async test "a transition is saved" {
    using let db = await TestDatabase();
    let _ = await AddIssue(db, ProjectId(1), NewIssue("Crash on save", "", Priority.High), Noon());
    let started = await Transition(db, IssueId(1), WorkflowEvent.Start("ada"), Noon().AddHours(1), Bus(MemoryTransport()));
    Assert(started is Ok(_));
    db.ChangeTracker.Clear();
    let stored = await FindIssue(db, IssueId(1));
    AssertEqual(Some(WorkflowState.InProgress), stored?.status);
    AssertEqual(Some(Some("ada")), stored?.assignee);
}

async test "search narrows by status and text, in SQL" {
    using let db = await TestDatabase();
    for title in ["Crash on save", "Crash on load", "Typo in footer"] {
        let _ = await AddIssue(db, ProjectId(1), NewIssue(title, "", Priority.Normal), Noon());
    }
    let _ = await Transition(db, IssueId(2), WorkflowEvent.Close("fixed"), Noon(), Bus(MemoryTransport()));

    AssertEqual(3, (await Search(db, ProjectId(1), None, None)).Count);
    AssertEqual([IssueId(1)], (await Search(db, ProjectId(1), Some(WorkflowState.Open), Some("Crash"))).Select(i => i.id).ToList());
    AssertEqual([IssueId(2)], (await Search(db, ProjectId(1), Some(WorkflowState.Closed), None)).Select(i => i.id).ToList());
}

async test "comments are kept in order" {
    using let db = await TestDatabase();
    let _ = await AddIssue(db, ProjectId(1), NewIssue("Crash on save", "", Priority.High), Noon());
    let _ = await AddComment(db, IssueId(1), "ada", "Seen it too", Noon());
    let _ = await AddComment(db, IssueId(1), "alan", "Fixed in 1.2", Noon().AddMinutes(5));
    AssertEqual(["ada", "alan"], (await CommentsOn(db, IssueId(1))).Select(c => c.author).ToList());
    Assert(await AddComment(db, IssueId(9), "ada", "?", Noon()) is Err(IssueError.NoIssue(IssueId(9))));
}

async test "a missing issue isn't found" {
    using let db = await TestDatabase();
    Assert(await FindIssue(db, IssueId(99)) == None);
}

async test "a transition saves the notification telling of it, and a refused one saves neither" {
    using let db = await TestDatabase();
    let transport = MemoryTransport();
    let bus = Bus(transport);
    let _ = await AddIssue(db, ProjectId(1), NewIssue("Crash on save", "", Priority.High), Noon());
    let started = await Transition(db, IssueId(1), WorkflowEvent.Start("ada"), Noon(), bus);
    Assert(started is Ok(_));
    AssertEqual(1, await DatabaseOutbox.WaitingAsync(db));
    AssertEqual(0, transport.Sent.Count);              // saved, not sent: the relay sends it

    let refused = await Transition(db, IssueId(1), WorkflowEvent.Approve, Noon(), bus);
    Assert(refused is Err(_));
    AssertEqual(1, await DatabaseOutbox.WaitingAsync(db));
}
