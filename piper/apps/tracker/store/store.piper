// Where the tracker keeps its projects, issues and comments: a SQLite database through EF Core.
namespace Tracker;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;

database TrackerDb {
    table Projects: Project key id index code;
    table Issues: Issue key id index projectId index (projectId, status);
    table Comments: Comment key id index issueId;
}

/// A database for <paramref name="connection"/>, with its tables made if they aren't there.
async fn OpenDatabase(connection: string) => Task<TrackerDb> {
    let db = TrackerDb(DbContextOptionsBuilder<TrackerDb>().UseSqlite(connection).Options);
    await db.Database.OpenConnectionAsync();
    await db.Database.EnsureCreatedAsync();
    db
}

async fn FindIssue(db: TrackerDb, id: IssueId) => Task<Issue?> =
    await db.Issues.FirstOrDefaultAsync(i => i.id == id);

async fn AddIssue(db: TrackerDb, projectId: ProjectId, request: NewIssue, now: DateTime) => Task<Result<Issue, IssueError>> {
    if !await db.Projects.AnyAsync(p => p.id == projectId) {
        return Err(IssueError.NoProject(projectId));
    }
    let issue = Create(IssueId(0), projectId, request, now);      // 0: the database numbers it
    db.Issues.Add(issue);
    await db.SaveChangesAsync();
    Ok(issue)
}

/// Moves an issue through its workflow, and saves it.
async fn Transition(db: TrackerDb, id: IssueId, event: WorkflowEvent, now: DateTime) => Task<Result<Issue, IssueError>> {
    let Some(issue) = await FindIssue(db, id) else { return Err(IssueError.NoIssue(id)); };
    let result = Apply(issue, event, now);
    if result is Ok(_) {
        await db.SaveChangesAsync();
    }
    result
}

/// A project's issues, newest first, narrowed by status and by words in the title when given.
async fn Search(db: TrackerDb, projectId: ProjectId, status: WorkflowState?, text: string?) => Task<List<Issue>> {
    mut query = db.Issues.Where(i => i.projectId == projectId);
    if status is Some(wanted) {
        query = query.Where(i => i.status == wanted);
    }
    if text is Some(words) {
        query = query.Where(i => i.title.Contains(words));
    }
    await query.OrderByDescending(i => i.created).ThenByDescending(i => i.id).ToListAsync()
}

async fn AddComment(db: TrackerDb, issueId: IssueId, author: string, text: string, now: DateTime) => Task<Result<Comment, IssueError>> {
    if !await db.Issues.AnyAsync(i => i.id == issueId) {
        return Err(IssueError.NoIssue(issueId));
    }
    let comment = Comment(CommentId(0), issueId, author, text, now);
    db.Comments.Add(comment);
    await db.SaveChangesAsync();
    Ok(comment)
}

async fn CommentsOn(db: TrackerDb, issueId: IssueId) => Task<List<Comment>> =
    await db.Comments.Where(c => c.issueId == issueId).OrderBy(c => c.created).ToListAsync();
