namespace Auction;

using System;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Threading.Tasks;
using Piper.Web;

async test "lots are listed, sold, bid on and pushed to the pages watching them, over HTTP" {
    // Served from memory: the address the server asks for isn't used.
    let auction = Auctioneer.Spawn(Broadcast);
    using let site = await TestClient.Start(() => AuctionServer("http://127.0.0.1:0", auction, TimeSpan.FromHours(1)));
    await auction.Open(NewLot("Brass carriage clock", "Victorian.", "Ada", Money(40m), None, 5), DateTime.UtcNow);

    // The list, and searching it.
    let home = await site.GetStringAsync(SiteRoutes.Home());
    Assert(home.Contains(">Brass carriage clock</a>") && home.Contains("sse-connect=\"/_piper/live?topic=lots\""));
    Assert((await site.GetStringAsync($"{SiteRoutes.Search()}?q=vase")).Contains("Nothing found."));

    // Selling something: what's wrong, beside its fields; then listed, and htmx sent to it.
    let wrong = await site.PostForm(SiteRoutes.CreateLot(),
        ["title": "", "description": "", "seller": "Grace", "startPrice": "lots", "minutes": "5"], htmx: true);
    let form = await wrong.Content.ReadAsStringAsync();
    Assert(form.Contains("&#39;lots&#39; isn&#39;t a number."), form);
    // A price of nothing is refused by Money itself, and said beside its field.
    let nothing = await site.PostForm(SiteRoutes.CreateLot(),
        ["title": "Lamp", "description": "", "seller": "Grace", "startPrice": "0", "minutes": "5"], htmx: true);
    Assert((await nothing.Content.ReadAsStringAsync()).Contains("<span class=\"error\">It must be more than nothing.</span>"));
    let listed = await site.PostForm(SiteRoutes.CreateLot(),
        ["title": "Oak desk", "description": "", "seller": "Grace", "startPrice": "100", "reserve": "150", "minutes": "5"], htmx: true);
    let destination = listed.Headers.GetValues("HX-Redirect").Single();
    AssertEqual(SiteRoutes.Lot(LotId(2)), destination);

    // A page watching the lot, and a bid through its form: the bidder is told, and the watching page is pushed to.
    let page = await site.GetStringAsync(destination);
    Assert(page.Contains($"sse-connect=\"{Live.Url(LotTopic(LotId(2)))}\""));
    using let watching = await site.GetAsync(Live.Url(LotTopic(LotId(2))), HttpCompletionOption.ResponseHeadersRead);
    using let events = StreamReader(await watching.Content.ReadAsStreamAsync());
    await events.ReadLineAsync();   // ": connected"
    await events.ReadLineAsync();

    let bid = await site.PostForm(SiteRoutes.Bid(LotId(2)), ["bidder": "Alan", "amount": "100"], htmx: true);
    Assert((await bid.Content.ReadAsStringAsync()).Contains("You&#39;re the highest bidder."));
    AssertEqual("event: price", await events.ReadLineAsync() ?? "");
    Assert((await events.ReadLineAsync() ?? "").Contains("&#163;100.00"));

    let low = await site.PostForm(SiteRoutes.Bid(LotId(2)), ["bidder": "Ada", "amount": "100"], htmx: true);
    Assert((await low.Content.ReadAsStringAsync()).Contains("Bid at least &#163;105.00."));   // £100, and £5 more above £100
    AssertEqual(HttpStatusCode.NotFound, (await site.GetAsync(SiteRoutes.Lot(LotId(99)))).StatusCode);
}

async test "a form posted without its anti-forgery token is refused" {
    using let site = await TestClient.Start(() => AuctionServer("", Auctioneer.Spawn(Broadcast), TimeSpan.FromHours(1)));
    let request = HttpRequestMessage(HttpMethod.Post, SiteRoutes.Bid(LotId(1))) {
        Content: FormUrlEncodedContent(["bidder": "Alan", "amount": "100"]),
    };
    AssertEqual(HttpStatusCode.BadRequest, (await site.SendAsync(request)).StatusCode);
}
