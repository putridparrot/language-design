// Starting the auction: the app (which tells the lots the time), and a few lots to bid on.
namespace Auction;

using System;
using System.Threading.Tasks;
using Microsoft.Extensions.Hosting;

args Options "Auction: lots listed and bid on live, in the browser." {
    port: int = 5090 "Where to serve it";
    empty: bool "Start with no lots (without it, a few are listed to bid on)";
}

async fn Main(args: string[]) {
    let options = Options.FromArgs(args);
    let auction = Auctioneer.Spawn(Broadcast);
    let app = AuctionServer($"http://localhost:{options.port}", auction, TimeSpan.FromSeconds(1));
    if !options.empty {
        await ListDemoLots(auction, DateTime.UtcNow);
    }
    await app.StartAsync();
    Print($"Auction on http://localhost:{options.port}; Ctrl+C to stop.");
    await app.WaitForShutdownAsync();
}

async fn ListDemoLots(auction: Auctioneer, now: DateTime) {
    let lots = [
        NewLot("Brass carriage clock", "Victorian, keeps good time, with its key.", "Ada", Money(40m), Some(Money(60m)), 5),
        NewLot("Pair of blue glass vases", "Hand blown, 30cm tall. Not a chip on them.", "Alan", Money(15m), None, 3),
        NewLot("Oak writing desk", "Three drawers, leather top, some wear.", "Grace", Money(120m), Some(Money(200m)), 10),
    ];
    for lot in lots {
        await auction.Open(lot, now);
    }
}
