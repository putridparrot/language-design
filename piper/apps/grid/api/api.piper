// The coordinator's HTTP API: start and cancel jobs, see how they're going, and the dashboard.
namespace GridApp;

using System;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;

/// The routes, each taking the coordinator's `Jobs` from the server's services:
/// - `GET /`: the dashboard
/// - `GET /status`: the running (or last) job, its chunks, the workers, and the history
/// - `POST /jobs?chunks=200&scenarios=100000&seed=42`: starts a job, or 409 if one is running
/// - `POST /jobs/cancel`: stops the running job
endpoints GridApi {
    get "/status" async (jobs: Jobs) => await jobs.Status();

    post "/jobs" async (chunks: int, scenarios: int, seed: int, jobs: Jobs) => {
        if chunks < 1 || chunks > 5_000 || scenarios < 1 || scenarios > 10_000_000 {
            return Results.BadRequest("chunks must be 1 to 5,000, and scenarios 1 to 10,000,000");
        }
        if await jobs.Start(JobSpec(chunks, scenarios, seed)) { Results.Ok() } else { Results.Conflict("a job is running") }
    }

    post "/jobs/cancel" async (jobs: Jobs) => if await jobs.Cancel() { Results.Ok() } else { Results.Conflict("no job is running") };

    get "/" () => Results.Content(DashboardPage(), "text/html");
}

/// The coordinator's API, set up but not started, listening on `url`. Becomes `fn GridServer(jobs, url) => WebApplication`.
server GridServer(jobs: Jobs, url: string) {
    urls url;
    logging off;
    // Traces, metrics and logs, when OTEL_EXPORTER_OTLP_ENDPOINT says where: Aspire's dashboard, Jaeger, a collector.
    telemetry "grid-coordinator";
    singleton Jobs = jobs;
    endpoints GridApi;

    // For Kubernetes: /healthz while the process runs (its liveness probe); /ready once the jobs actor answers (its
    // readiness probe).
    health "/healthz" ready "/ready" {
        check "jobs" async (jobs: Jobs) => {
            let _ = await jobs.Status();
            true
        }
    }
}
