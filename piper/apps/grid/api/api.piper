// The coordinator's HTTP API: start and cancel jobs, see how they're going, and the dashboard.
namespace GridApp;

using System;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Logging;

/// The API, set up but not started, listening on `url`:
/// - `GET /`: the dashboard
/// - `GET /status`: the running (or last) job, its chunks, the workers, and the history
/// - `POST /jobs?chunks=200&scenarios=100000&seed=42`: starts a job, or 409 if one is running
/// - `POST /jobs/cancel`: stops the running job
/// - `GET /healthz`: "ok", for Kubernetes' probes
fn BuildApi(jobs: Jobs, url: string) => WebApplication {
    let builder = WebApplication.CreateBuilder();
    builder.Logging.ClearProviders();
    let urls: string[] = [url];
    builder.WebHost.UseUrls(urls);
    let app = builder.Build();

    app.MapGet("/status", async () => await jobs.Status());
    app.MapPost("/jobs", async (chunks: int, scenarios: int, seed: int) => {
        if chunks < 1 || chunks > 5_000 || scenarios < 1 || scenarios > 10_000_000 {
            return Results.BadRequest("chunks must be 1 to 5,000, and scenarios 1 to 10,000,000");
        }
        if await jobs.Start(JobSpec(chunks, scenarios, seed)) { Results.Ok() } else { Results.Conflict("a job is running") }
    });
    app.MapPost("/jobs/cancel", async () => if await jobs.Cancel() { Results.Ok() } else { Results.Conflict("no job is running") });
    app.MapGet("/healthz", () => "ok");
    let page = DashboardPage();
    app.MapGet("/", () => Results.Content(page, "text/html"));
    app
}
