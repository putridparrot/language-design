// The coordinator's actor, and the workers' side: each worker asks the coordinator for a chunk, works it out, and
// sends back what it found, until it's stopped.
namespace GridApp;

using System;
using System.Collections.Immutable;
using System.Diagnostics;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using Piper.Runtime;
using Piper.Actors.Remote;

/// The coordinator's jobs, hosted under the name "jobs". It holds the board and applies the rules in board.piper one
/// message at a time, so workers asking at once on many nodes are given different chunks.
///
/// It keeps the board as events, each the input to one of those rules with the time it happened, so a coordinator
/// that restarts replays them and carries on with its job: the chunks done stay done, the ones out are still lent
/// (a worker sends its chunk back to the new coordinator, as workers retry), and the history is kept. A worker told
/// to wait is only noted in `asked`, which is transient: idle workers ask every half second, which isn't worth keeping.
actor Jobs(id: string) persisted by id {
    mut board = NewBoard(DateTime.UtcNow);
    transient mut asked = ImmutableDictionary.Create<string, DateTime>();
    snapshot every 100;

    event Started(spec: JobSpec, at: DateTime) { board = StartJob(board, spec, at).board; }
    event Taken(worker: string, at: DateTime) { board = TakeWork(board, worker, at).board; }
    event Completed(tally: Tally, at: DateTime) { board = Complete(board, tally, at).board; }
    event Cancelled(at: DateTime) { board = CancelJob(board, at).board; }

    on Start(spec: JobSpec) => bool {
        let now = DateTime.UtcNow;
        let started = StartJob(board, spec, now).started;
        if started {
            emit Started(spec, now);
        }
        started
    }

    on Take(worker: string) => Assignment {
        let now = DateTime.UtcNow;
        let assignment = TakeWork(board, worker, now).assignment;
        match assignment {
            Work(_) => {
                emit Taken(worker, now);
            },
            Wait => {
                asked = asked.SetItem(worker, now);
            },
        }
        assignment
    }

    on Done(tally: Tally) => bool {
        let now = DateTime.UtcNow;
        let kept = Complete(board, tally, now).kept;
        emit Completed(tally, now);
        kept
    }

    on Cancel() => bool {
        let now = DateTime.UtcNow;
        let cancelled = CancelJob(board, now).cancelled;
        if cancelled {
            emit Cancelled(now);
        }
        cancelled
    }

    on Status() => View { Describe(Heard(board, asked), DateTime.UtcNow) }
}

/// Runs `count` workers on this node, called `name` (with a number after it, for more than one), each taking chunks
/// from the coordinator at `coordinator` until `stop` is cancelled.
async fn RunWorkers(system: ActorSystem, coordinator: string, name: string, count: int, stop: CancellationToken) {
    let names = if count == 1 { [name] } else { [...Enumerable.Range(1, count).Select(i => $"{name}/{i}")] };
    await Task.WhenAll(names.Select(worker => Work(system, coordinator, worker, stop)));
}

/// One worker: asks for a chunk, simulates it (on the thread pool, as it's all computation), and sends back the
/// sample. With nothing to do it asks again in half a second; if the coordinator can't be reached (it's restarting)
/// it tries again in a second, so workers can start before it, and carry on after it restarts.
async fn Work(system: ActorSystem, coordinator: string, worker: string, stop: CancellationToken) {
    let jobs = Jobs.Connect(system, coordinator, "jobs");
    while !stop.IsCancellationRequested {
        mut pause = 0;
        try {
            match await jobs.Take(worker) {
                Work(chunk) => {
                    let clock = Stopwatch.StartNew();
                    let sample = await Task.Run(() => Simulate(chunk.scenarios, chunk.seed));
                    await jobs.Done(Tally(chunk.job, chunk.id, worker, sample, clock.ElapsedMilliseconds));
                },
                Wait => {
                    pause = 500;
                },
            }
        } catch (_: Exception) {
            pause = 1_000;
        }
        if pause > 0 {
            try {
                await Task.Delay(pause, stop);
            } catch (_: OperationCanceledException) {
            }
        }
    }
}
