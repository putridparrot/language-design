namespace GridApp;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using Piper.Actors.Remote;
using Piper.Runtime;

async fn WaitForJob(jobs: Jobs, job: int) => Task<View> {
    let deadline = DateTime.UtcNow.AddSeconds(60);
    mut view = await jobs.Status();
    while (view.running || view.job < job) && DateTime.UtcNow < deadline {
        await Task.Delay(100);
        view = await jobs.Status();
    }
    view
}

// The tests run in a simulated cluster (Piper.Actors.Remote's SimulatedCluster): its network, and the leases, pauses and
// timeouts, on the simulation's clock, so the 30-second lease takes no real time, and each test runs over several seeds.

async test "workers on three nodes share a job; a worker cut off mid-chunk has it done by another, and its late answer is ignored" simulate runs 5 {
    // Five nodes: the coordinator, a worker to cut off, three more.
    let cluster = await SimulatedCluster.StartAsync(5, _ => {});
    let coordinator = cluster[0];
    let jobs = Jobs.Spawn(coordinator, "jobs", MemoryEventStore(), "grid");
    Assert(await jobs.Start(JobSpec(12, 2_000, 5)));

    // A worker on node 1 takes a chunk, and then the network cuts its node off, as a failing machine's would.
    let cutOff = Jobs.Connect(cluster[1], coordinator.Address, "jobs");
    AssertEqual(0, Given(await cutOff.Take("cut-off")));
    cluster.Isolate(1);

    // Three workers until the job's done, then stopped; if waiting for it fails, they're stopped all the same.
    let view = await TaskScope.Run { scope =>
        for i in 2..4 {
            scope.Start { stop => RunWorkers(cluster[i], coordinator.Address, $"w{i}", 1, stop) }
        }
        let view = await WaitForJob(jobs, 1);
        scope.Cancel();
        view
    };

    // Back again, it sends its chunk's answer: after the job finished without it, so it's ignored.
    cluster.Heal();
    Assert(!(await cutOff.Done(Tally(1, 0, "cut-off", Simulate(2_000, ChunkSeed(5, 0)), 10L))));
    let after = await jobs.Status();

    Assert(!view.running, "the job didn't finish within a minute");
    AssertEqual(1, after.late);
    let run = view.history.Single();
    AssertEqual(1, run.retried);
    Assert(view.cells[0].worker != "cut-off");
    let expected = Combine(Enumerable.Range(0, 12).Select(id => Simulate(2_000, ChunkSeed(5, id))));
    AssertEqual(expected.var99, run.valuation.var99);
    AssertEqual(expected.mean, run.valuation.mean);
    Assert(expected.histogram.SequenceEqual(run.valuation.histogram));
}

/// What chunk `id` of a job with seed 4 and 50 scenarios sends back.
fn Small(id: int, worker: string) => Tally = Tally(1, id, worker, Simulate(50, ChunkSeed(4, id)), 10L);

async test "a coordinator that restarts carries on with its job, from its snapshot and the events since" simulate runs 5 {
    let store = MemoryEventStore();
    let cluster = await SimulatedCluster.StartAsync(1, _ => {});
    let jobs = Jobs.Spawn(cluster[0], "jobs", store, "grid");
    Assert(await jobs.Start(JobSpec(60, 50, 4)));
    for id in 0..57 {   // two events each, so a snapshot is taken after the 100th
        AssertEqual(id, Given(await jobs.Take("a")));
        Assert(await jobs.Done(Small(id, "a")));
    }
    AssertEqual(58, Given(await jobs.Take("b")));   // lent to b and c, which are still working on them
    AssertEqual(59, Given(await jobs.Take("c")));
    await cluster.StopAsync(0);
    match await store.LoadSnapshotAsync("Jobs/grid") {
        Some(kept) => AssertEqual(100, kept.Version),   // Started, 49 chunks taken and done, and the 50th taken
        None => Assert(false, "no snapshot was taken"),
    }

    await cluster.RestartAsync(0);
    let again = Jobs.Spawn(cluster[0], "jobs", store, "grid");
    let view = await again.Status();
    Assert(view.running);
    AssertEqual(58, view.done);
    AssertEqual(2, view.outstanding);
    AssertEqual("b", view.cells[58].worker);
    Assert(!(await again.Start(JobSpec(5, 10, 1))), "a second job started while the first was still running");

    // b and c send their chunks back to the new coordinator, and the job finishes with every chunk's sample.
    for (id, worker) in [(58, "b"), (59, "c")] {
        Assert(await again.Done(Small(id, worker)));
    }
    let done = await again.Status();
    Assert(!done.running);
    let expected = Combine(Enumerable.Range(0, 60).Select(id => Simulate(50, ChunkSeed(4, id))));
    AssertEqual(expected.var99, done.history.Single().valuation.var99);
    Assert(expected.histogram.SequenceEqual(done.history.Single().valuation.histogram));
}
