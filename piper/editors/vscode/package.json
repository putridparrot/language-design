{
  "name": "piper-language",
  "displayName": "Piper",
  "description": "Piper language support: syntax highlighting, running and debugging, and diagnostics, hover, go to definition, references, rename, completion and an outline from the Piper language server.",
  "version": "1.0.0",
  "publisher": "putridparrot",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:piper"
  ],
  "contributes": {
    "languages": [
      {
        "id": "piper",
        "aliases": [
          "Piper",
          "piper"
        ],
        "extensions": [
          ".piper"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "piper",
        "scopeName": "source.piper",
        "path": "./syntaxes/piper.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "piper"
      }
    ],
    "debuggers": [
      {
        "type": "piper",
        "label": "Piper",
        "languages": [
          "piper"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "The program to debug: a .piper file (with every file of its program) or a folder of .piper files."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Command-line arguments for the program."
              },
              "cwd": {
                "type": "string",
                "description": "The working directory (default: the program's folder)."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment variables for the program."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole",
                "description": "Where the program's output goes. Use integratedTerminal for a program that reads input."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "piper",
            "request": "launch",
            "name": "Debug Piper program",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Piper: Debug",
            "description": "Debug a Piper program",
            "body": {
              "type": "piper",
              "request": "launch",
              "name": "Debug Piper program",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Piper",
      "properties": {
        "piper.server.path": {
          "type": "string",
          "default": "piper",
          "description": "The command that starts the language server: the `piper` tool (`dotnet tool install -g Piper`), or `dotnet` to run a built piper.dll."
        },
        "piper.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments for the server command, e.g. [\"path/to/piper.dll\", \"lsp\"] when the path is `dotnet`."
        },
        "piper.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server to the Piper output channel."
        }
      }
    },
    "commands": [
      {
        "command": "piper.restartServer",
        "title": "Piper: Restart Language Server"
      },
      {
        "command": "piper.run",
        "title": "Piper: Run",
        "icon": "$(play)"
      },
      {
        "command": "piper.debug",
        "title": "Piper: Debug",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "piper.run",
          "when": "resourceLangId == piper",
          "group": "navigation"
        },
        {
          "command": "piper.debug",
          "when": "resourceLangId == piper",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "piper.run",
          "when": "editorLangId == piper"
        },
        {
          "command": "piper.debug",
          "when": "editorLangId == piper"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piper.run",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorLangId == piper"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
