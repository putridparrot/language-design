{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Piper",
  "scopeName": "source.piper",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.piper", "match": "//.*$" },
        { "name": "comment.block.piper", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block-comment-nested" }] }
      ]
    },
    "block-comment-nested": {
      "name": "comment.block.piper",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block-comment-nested" }]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.function.piper" }, "2": { "name": "entity.name.function.piper" } }
        },
        {
          "match": "\\b(record|enum|trait|class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.type.piper" }, "2": { "name": "entity.name.type.piper" } }
        },
        {
          "match": "\\b(extend)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": { "1": { "name": "keyword.declaration.piper" }, "2": { "name": "entity.name.type.piper" } }
        },
        {
          "match": "\\b(namespace|using)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": { "1": { "name": "keyword.other.namespace.piper" }, "2": { "name": "entity.name.namespace.piper" } }
        },
        {
          "match": "\\b(let|mut)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.piper" }, "2": { "name": "variable.other.piper" } }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.piper",
          "begin": "\"\"\"+",
          "end": "\"\"\"+"
        },
        {
          "name": "string.quoted.double.piper",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            { "name": "constant.character.escape.piper", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)" },
            {
              "name": "meta.interpolation.piper",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.piper" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.piper" } },
              "contentName": "source.piper",
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.piper",
      "match": "'(\\\\(u\\{[0-9A-Fa-f]+\\}|.)|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.piper", "match": "\\b0[xX][0-9A-Fa-f_]+(UL|ul|U|u|L|l)?\\b" },
        { "name": "constant.numeric.binary.piper", "match": "\\b0[bB][01_]+(UL|ul|U|u|L|l)?\\b" },
        { "name": "constant.numeric.decimal.piper", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?(UL|ul|U|u|L|l|F|f|D|d|M|m)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.piper", "match": "\\b(if|else|while|for|in|return|break|continue|match|try|catch|finally|throw|defer|yield|await)\\b" },
        { "name": "keyword.declaration.piper", "match": "\\b(fn|record|class|enum|trait|extend|namespace|using|let|mut|test|operator|requires)\\b" },
        { "name": "storage.modifier.piper", "match": "\\b(static|private|public|async|out|ref|abstract|sealed|virtual|override)\\b" },
        { "name": "keyword.operator.word.piper", "match": "\\bis\\b" },
        { "name": "variable.language.this.piper", "match": "\\bthis\\b" },
        { "name": "constant.language.piper", "match": "\\b(true|false|null|None)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.piper", "match": "\\b(int|long|double|bool|string|char|object|byte|sbyte|short|ushort|uint|ulong|float|decimal|unit)\\b" },
        { "name": "entity.name.type.piper", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=(<[^<>()]*>)?\\()",
      "captures": { "1": { "name": "entity.name.function.call.piper" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.piper", "match": "=>|\\|>|\\?>" },
        { "name": "keyword.operator.range.piper", "match": "\\.\\.\\.|\\.\\.<?" },
        { "name": "keyword.operator.null.piper", "match": "\\?\\?|\\?\\.|\\?" },
        { "name": "keyword.operator.comparison.piper", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.piper", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.piper", "match": "[-+*/%&|^]?=|<<=|>>=" },
        { "name": "keyword.operator.piper", "match": "[-+*/%<>&|^~]" }
      ]
    }
  }
}
