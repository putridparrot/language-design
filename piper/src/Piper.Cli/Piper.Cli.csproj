<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>piper</AssemblyName>

    <!-- `dotnet tool install -g Piper` gives a `piper` command. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>piper</ToolCommandName>
    <PackageId>Piper</PackageId>
    <Description>The Piper compiler: a small, expression-oriented language that transpiles to C#. `piper run hello.piper` compiles and runs a program; `piper build` writes the C#.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piper.Compiler\Piper.Compiler.csproj" />
    <ProjectReference Include="..\Piper.LanguageServer\Piper.LanguageServer.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Browser reload for watched runs (src/Piper.Watch), built against ASP.NET Core, which piper itself doesn't
    use: so built, not referenced, and copied beside piper.dll for watched web programs to load.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Piper.Watch\Piper.Watch.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="IncludeBrowserReload" AfterTargets="IncludeBundledPlugins">
    <ItemGroup>
      <ContentWithTargetPath Include="$(MSBuildThisFileDirectory)..\Piper.Watch\bin\runtime\Piper.Watch.dll" TargetPath="Piper.Watch.dll"
                             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Import Project="..\BundledPlugins.targets" />

</Project>
