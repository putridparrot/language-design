<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Not used by the compiler itself: programs it compiles and runs in memory (Runner) reference it. -->
    <ProjectReference Include="..\Piper.Runtime\Piper.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `piper new` makes (see ProjectTemplates), named by their paths: Templates/web/main.piper. -->
    <EmbeddedResource Include="Templates\**" LogicalName="Templates/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
