fn RequiredFunction(i: int?) => unit
    requires i is Some(> 0) 
{
    if i is Some(value) {
        Print(value);
    }

    // match i {
    //     Some(value) => Print(value),
    //     None => {},
    // }
    //Print(i ?? 0);
}

enum MathError {
    DivideByZero,
    Negative(value: int),
}

// fn Compute(a: int, b: int) => Result<int> {
//     return Ok((a + b) * 10)
// }

fn F(a: int, b: int) => Result<int, MathError> {
    Ok(a + b)
}

fn Main() 
{
    match F(b: 5, a: 3) { 
        Ok(value) => value
            |> (x: int) => x * 2
            |> Print,
        Err(_) => Print(0),
    }   

