// A small to-do REST API: services registered for dependency injection, and endpoints that use them.
//
//   piper run samples/todo-api --serve        serves on http://localhost:5080 until Ctrl+C
//   piper run samples/todo-api --serve --https    and on https://localhost:5081 too (--port 5090 for 5090 and 5091)
//   piper run samples/todo-api                starts on a free port, calls every endpoint, prints what comes back, stops
//
// With --serve, try (see README.md for more):
//   curl http://localhost:5080/api/todos
//   curl -X POST http://localhost:5080/api/todos -H "Content-Type: application/json" -d "{\"title\":\"Try Piper\",\"priority\":\"High\"}"

using System;
using System.Collections.Generic;
using System.Linq;
using System.Net.Http;
using System.Net.Http.Json;
using System.Text;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Logging;

// The data the API sends and receives. Records become JSON objects, an optional field is null when it's None, and an
// enum's variant is its name: { "id": 1, "title": "…", "done": false, "priority": "High", "note": null }.
enum Priority { Low, Normal, High }

record Todo(id: int, title: string, done: bool, priority: Priority, note: string?);

// What a client posts. The priority and note may be left out (None), and a title that's blank breaks the invariant,
// which ASP.NET Core answers with 400 Bad Request before the handler runs.
record NewTodo(title: string, priority: Priority?, note: string?) requires title.Trim() != "";

record Stats(total: int, done: int, open: int, since: string);

// A service behind a trait, so a test could give the API a fixed clock instead.
trait Clock {
    fn Now() => DateTime;
}

record SystemClock();

extend SystemClock: Clock {
    fn Now() => DateTime = DateTime.Now;
}

// The store: one for the whole app (a singleton), so what one request adds the next one sees. DI makes it, passing the
// Clock it's registered with.
class TodoStore(clock: Clock) {
    let todos: Dictionary<int, Todo> = Dictionary();
    let started = clock.Now();
    mut nextId = 1;

    prop Count => int = todos.Count;
    prop Done => int = todos.Values.Count(t => t.done);
    prop Since => string = started.ToString("HH:mm:ss");

    // All of them, or only those done (or not), as asked.
    fn All(done: bool?) => List<Todo> = todos.Values
        .Where(t => match done {
            Some(wanted) => t.done == wanted,
            None => true,
        })
        .OrderBy(t => t.id)
        .ToList();

    fn Find(id: int) => Todo? {
        if todos.TryGetValue(id, out let todo) {
            return Some(todo);
        }
        None
    }

    fn Add(request: NewTodo) => Todo {
        let todo = Todo(nextId, request.title.Trim(), false, request.priority ?? Priority.Normal, request.note);
        todos[todo.id] = todo;
        nextId += 1;
        todo
    }

    fn Complete(id: int) => Todo? = Find(id) ?> MarkDone;

    fn Remove(id: int) => bool = todos.Remove(id);

    private fn MarkDone(todo: Todo) => Todo {
        let done = { ...todo, done: true };
        todos[todo.id] = done;
        done
    }
}

// Turns titles into something friendlier; a new one each time it's asked for (transient).
class Greeter {
    fn Welcome(name: string) => string = $"Hello, {name}! You have work to do.";
}

// Becomes `fn AppServices(services: IServiceCollection) => IServiceCollection`.
services AppServices {
    singleton Clock => SystemClock;
    singleton TodoStore;
    transient Greeter;
}

// Becomes `fn TodoApi(app: IEndpointRouteBuilder)`. Each handler's parameters come from the route ({id}), the query
// string, the request's JSON body (a NewTodo), or the services (store, greeter, clock). An optional one (`done: bool?`)
// is None when the request leaves it out.
endpoints TodoApi "/api" {
    get "/todos" (done: bool?, store: TodoStore) => store.All(done);

    get "/todos/{id:int}" (id: int, store: TodoStore) => match store.Find(id) {
        Some(todo) => Results.Ok(todo),
        None => Results.NotFound($"No to-do {id}"),
    };

    // A blank title never gets here: NewTodo's invariant rejects it while the body is read.
    post "/todos" (request: NewTodo, store: TodoStore) => {
        let todo = store.Add(request);
        Results.Created($"/api/todos/{todo.id}", todo)
    }

    put "/todos/{id:int}/done" (id: int, store: TodoStore) => match store.Complete(id) {
        Some(todo) => Results.Ok(todo),
        None => Results.NotFound($"No to-do {id}"),
    };

    delete "/todos/{id:int}" (id: int, store: TodoStore) => store.Remove(id) ? Results.NoContent() : Results.NotFound($"No to-do {id}");

    get "/stats" (store: TodoStore) => Stats(store.Count, store.Done, store.Count - store.Done, store.Since);

    get "/hello" (name: string?, greeter: Greeter) => greeter.Welcome(name ?? "there");
}

// The command line, from the args plugin: `--help` lists these, and a mistake is reported before anything starts.
args Options "A small to-do REST API." {
    serve: bool "Serve until Ctrl+C, rather than call each endpoint once and stop";
    // HTTPS uses ASP.NET Core's development certificate, which `dotnet dev-certs https --trust` creates and trusts.
    https: bool "Serve HTTPS too, on the port after --port";
    port: int = 5080 "The port to serve HTTP on";
}

async fn Main(args: string[]) {
    let options = Options.FromArgs(args);
    let serve = options.serve;
    let port = options.port;
    let urls: string[] = !serve ? ["http://127.0.0.1:0"]
        : options.https ? [$"http://localhost:{port}", $"https://localhost:{port + 1}"]
        : [$"http://localhost:{port}"];

    let builder = WebApplication.CreateBuilder();
    if !serve {
        builder.Logging.ClearProviders();
    }
    builder.WebHost.UseUrls(urls);
    AppServices(builder.Services);

    let app = builder.Build();
    TodoApi(app);

    if serve {
        Print($"Serving on {string.Join(" and ", urls)} (try /api/todos, /api/stats, /api/hello?name=Ada). Ctrl+C to stop.");
        await app.RunAsync();
        return;
    }

    // Without --serve: start, call each endpoint as a client would, and stop.
    await app.StartAsync();
    using let client = HttpClient();
    client.BaseAddress = Uri(app.Urls.First());

    async fn Show(what: string, response: HttpResponseMessage) {
        let body = await response.Content.ReadAsStringAsync();
        Print($"{what} → {(int)response.StatusCode} {response.StatusCode} {body}");
    }

    await Show("POST /api/todos", await client.PostAsJsonAsync("/api/todos", NewTodo("Write a Piper server", Some(Priority.High), None)));
    await Show("POST /api/todos", await client.PostAsJsonAsync("/api/todos", NewTodo("Call it from curl", None, Some("with -X POST"))));
    // A NewTodo can't even be made with a blank title, so this sends the JSON itself.
    let blank = StringContent("""{"title": "  "}""", Encoding.UTF8, "application/json");
    await Show("POST /api/todos (blank title)", await client.PostAsync("/api/todos", blank));
    await Show("GET /api/todos", await client.GetAsync("/api/todos"));
    await Show("PUT /api/todos/1/done", await client.PutAsync("/api/todos/1/done", None));
    await Show("GET /api/todos?done=true", await client.GetAsync("/api/todos?done=true"));
    await Show("GET /api/todos/1", await client.GetAsync("/api/todos/1"));
    await Show("GET /api/todos/9", await client.GetAsync("/api/todos/9"));
    await Show("DELETE /api/todos/2", await client.DeleteAsync("/api/todos/2"));
    await Show("GET /api/todos", await client.GetAsync("/api/todos"));
    await Show("GET /api/hello?name=Ada", await client.GetAsync("/api/hello?name=Ada"));
    await Show("GET /api/hello", await client.GetAsync("/api/hello"));
    let stats = await client.GetFromJsonAsync<Stats>("/api/stats");
    Print($"GET /api/stats → {stats.total} total, {stats.done} done, {stats.open} open");

    await app.StopAsync();
}
