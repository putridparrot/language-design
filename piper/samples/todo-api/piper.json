{
  // `services` (dependency injection), `endpoints` (routes) and `args` (the command line) come from plugins that come
  // with piper; the web plugin brings in ASP.NET Core, and the openapi plugin the OpenAPI document. `piper run
  // samples/todo-api --serve` and open http://localhost:5080/api/todos (or /openapi/v1.json); `piper run
  // samples/todo-api --help` lists the options, and `piper test samples/todo-api` runs its tests.
  "plugins": ["args", "services", "web", "openapi"]
}
