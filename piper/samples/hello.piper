// Hello, Piper: a record, functions, a loop and string interpolation.

record Point(x: int, y: int);

fn Add(a: int, b: int) => int = a + b;      // expression-bodied

fn Classify(n: int) => string {
    let kind = if n < 0 { "negative" } else if n == 0 { "zero" } else { "positive" };
    return kind;
}

fn Main() {
    let p = Point(1, 2);
    mut total = 0;
    for i in 0..<10 { total += i; }           // half-open range; 0..10 is inclusive
    while total > 40 { total -= 1; }
    Print($"p=({p.x}, {p.y}) total={total} {Classify(-3)} {Add(2, 3)}");
}
