// .NET out parameters, as in C#: `out let n` declares n (`out mut n` declares it mutable),
// `out n` assigns an existing var, and `out _` discards.

using System;
using System.Collections.Generic;

fn ParseOr(text: string, fallback: int) => int = if int.TryParse(text, out let n) { n } else { fallback };

fn Describe(text: string) => string {
    // As in C#, a variable declared in an if condition is still in scope after the if.
    if !double.TryParse(text, out let value) {
        return $"'{text}' is not a number";
    }
    $"'{text}' is {value * 2} doubled"
}

fn Main() {
    Print(ParseOr("42", 0));
    Print(ParseOr("forty-two", -1));
    Print(Describe("1.25"));
    Print(Describe("abc"));

    // An existing var, and a discard.
    mut count = 0;
    if int.TryParse("7", out count) {
        count += 1;
    }
    Print(count);
    Print(int.TryParse("8", out _));

    // `out var` declares a mutable variable.
    if long.TryParse("10", out mut big) {
        big *= 3;
        Print(big);
    }

    // TryGetValue writes null only when it returns false: where it returned true, the variable is a plain value.
    let names: Dictionary<string, string> = Dictionary();
    names["ada"] = "Ada Lovelace";
    if names.TryGetValue("ada", out let full) {
        Print(full.Length);
    }
    // Anywhere else it is optional, since the call may have returned false.
    let found = names.TryGetValue("bob", out let missing);
    Print($"{found} {missing ?? "none"}");
    if names.TryGetValue("ada", out let first) && first.StartsWith("Ada") {
        Print("starts with Ada");
    }
    Print(Lookup(names, "ada"));
    Print(Lookup(names, "bob"));

    // A value type comes back as itself.
    let ages: Dictionary<string, int> = Dictionary();
    ages["Ada"] = 36;
    Print(ages.TryGetValue("Ada", out let age) && age > 30);

    // In a loop condition.
    let inputs = ["1", "x", "3"];
    mut total = 0;
    for input in inputs {
        if int.TryParse(input, out let n) {
            total += n;
        }
    }
    Print(total);
}

// A guard: after `if !…TryGetValue(…) { return …; }` the value is there.
fn Lookup(names: Dictionary<string, string>, key: string) => string {
    if !names.TryGetValue(key, out let name) {
        return $"no {key}";
    }
    name.ToUpper()
}
