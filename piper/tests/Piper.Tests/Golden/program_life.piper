// A larger program: Conway's Game of Life on a small wrapping grid, using a two-dimensional array.

using System;
using System.Text;

record Grid(cells: bool[,], rows: int, columns: int);

fn Parse(pattern: string) => Grid {
    let lines = pattern.Split('\n');
    let rows = lines.Length;
    let columns = lines[0].Length;
    let cells = bool[rows, columns];
    for row in 0..<rows {
        for column in 0..<columns {
            cells[row, column] = lines[row][column] == '#';
        }
    }
    Grid(cells, rows, columns)
}

fn Neighbours(grid: Grid, row: int, column: int) => int {
    mut count = 0;
    for dr in -1..1 {
        for dc in -1..1 {
            if (dr, dc) == (0, 0) {
                continue;
            }
            // Wrap around the edges.
            let r = (row + dr + grid.rows) % grid.rows;
            let c = (column + dc + grid.columns) % grid.columns;
            if grid.cells[r, c] {
                count += 1;
            }
        }
    }
    count
}

fn Step(grid: Grid) => Grid {
    let next = bool[grid.rows, grid.columns];
    for row in 0..<grid.rows {
        for column in 0..<grid.columns {
            next[row, column] = match (grid.cells[row, column], Neighbours(grid, row, column)) {
                (true, 2) | (_, 3) => true,
                _ => false,
            };
        }
    }
    Grid(next, grid.rows, grid.columns)
}

fn Render(grid: Grid) => string {
    let builder = StringBuilder();
    for row in 0..<grid.rows {
        for column in 0..<grid.columns {
            builder.Append(if grid.cells[row, column] { '#' } else { '.' });
        }
        if row < grid.rows - 1 {
            builder.Append('\n');
        }
    }
    builder.ToString()
}

fn Population(grid: Grid) => int {
    mut alive = 0;
    for cell in grid.cells {
        if cell {
            alive += 1;
        }
    }
    alive
}

fn Main() {
    // A glider on a 6x6 torus.
    let glider = """
        .#....
        ..#...
        ###...
        ......
        ......
        ......
        """;
    mut grid = Parse(glider);

    for generation in 0..4 {
        Print("generation {generation}, population {Population(grid)}:");
        Print(Render(grid));
        grid = Step(grid);
    }

    // A glider moves one cell diagonally every 4 generations, so on a 6x6 torus it's back after 24.
    for _ in 5..<24 {
        grid = Step(grid);
    }
    Print("back to the start after 24: {Render(grid) == glider}");
}
