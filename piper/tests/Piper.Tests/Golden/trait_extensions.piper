// Generic trait methods, traits overriding methods they inherit, and `extend Trait` adding default methods.

using System.Collections.Generic;

// A trait method with type parameters of its own; implementers may rename them.
trait Container<T> {
    fn items() => List<T>;
    fn mapAll<U>(f: (T) => U) => List<U>;
    fn pick<S: Named>(a: S, b: S) => S = if a.name().Length >= b.name().Length { a } else { b };
}

trait Named {
    fn name() => string;
    fn greet() => string = "Hello, {this.name()}";
}

// Overriding an inherited default, and giving an inherited required method a default.
trait Formal: Named {
    fn title() => string;
    fn greet() => string = "Good day, {this.title()} {this.name()}";
}

trait Anonymous: Named {
    fn name() => string = "anonymous";
}

// Overriding through a generic parent.
trait Equatable<T> {
    fn same(other: T) => bool;
}

trait Ordered<T>: Equatable<T> {
    fn compare(other: T) => int;
    fn same(other: T) => bool = this.compare(other) == 0;
}

// Two parents override `greet`, so this trait must pick.
trait Polite: Formal, Anonymous {
    fn greet() => string = "Welcome, {this.title()}";
}

// Methods added to a trait after its declaration are defaults for every implementer.
extend Named {
    fn shout() => string = this.greet().ToUpper();
}

record Bag(values: List<int>);
record Person(n: string);
record Judge(n: string);
record Ghost(id: int);
record Num(v: int);
record Butler(id: int);

extend Bag: Container<int> {
    fn items() => List<int> = this.values;
    fn mapAll<R>(f: (int) => R) => List<R> {
        var result = List<R>();
        for v in this.values {
            result.Add(f(v));
        }
        result
    }
}

extend Person: Named { fn name() => string = this.n; }
extend Judge: Formal { fn name() => string = this.n; fn title() => string = "Judge"; }
extend Ghost: Anonymous { }
extend Num: Ordered<Num> { fn compare(other: Num) => int = this.v - other.v; }
extend Butler: Polite { fn title() => string = "sir"; }

fn labels<C: Container<int>>(c: C) => List<string> = c.mapAll((x) => "#{x}");

fn welcome(n: Named) => string = n.greet();

fn main() {
    let bag = Bag([1, 2, 3]);
    print(bag.mapAll((x) => x * 10)[2]);
    let c: Container<int> = bag;
    print(c.mapAll((x) => x % 2 == 0)[1]);
    print(labels(bag)[0]);
    print(bag.pick(Person("Ann"), Person("Bartholomew")).name());

    print(Person("Ann").greet());
    print(Judge("Dredd").greet());
    print(welcome(Judge("Rinder")));
    print(Ghost(1).greet());
    print(Butler(1).greet());
    print(Butler(1).name());
    print(Num(3).same(Num(3)));
    print(Num(3).same(Num(4)));
    print(Judge("Dredd").shout());
}
