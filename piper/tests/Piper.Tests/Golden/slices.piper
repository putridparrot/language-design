// Counting from the end (^) and slicing, on lists, arrays and strings. A slice's range includes its end unless it's
// '..<', as in a for loop.
using System.Collections.Generic;

fn Main() {
    let xs = [10, 20, 30, 40, 50];
    let array: int[] = [1, 2, 3, 4, 5];
    let name = "Piper language";
    let n = 2;
    Print(xs[^1]);
    Print(array[^2]);
    Print(name[^1]);
    Print(string.Join(",", xs[1..3]));
    Print(string.Join(",", xs[1..<3]));
    Print(string.Join(",", xs[2..]));
    Print(string.Join(",", xs[..<2]));
    Print(string.Join(",", xs[..2]));
    Print(string.Join(",", xs[^2..]));
    Print(string.Join(",", xs[1..^1]));
    Print(string.Join(",", xs[1..<^1]));
    Print(string.Join(",", array[n..n + 1]));
    Print(name[..4]);
    Print(name[^8..]);
    Print(string.Join(",", xs[..]));
}
