// Traits with required and default methods, implemented by records and enums.
// Traits work both as generic constraints (static dispatch) and as types (dynamic dispatch).

trait Shape {
    fn Area() => double;
    fn Name() => string;
    fn Describe() => string = $"{this.Name()} with area {this.Area()}";
}

record Circle(radius: double);
record Rect(width: double, height: double);

extend Circle: Shape {
    fn Area() => double = 3.0 * this.radius * this.radius;
    fn Name() => string = "circle";
}

extend Rect: Shape {
    fn Area() => double = this.width * this.height;
    fn Name() => string = if this.width == this.height { "square" } else { "rectangle" };
    fn Describe() => string = $"a {this.width}x{this.height} {this.Name()}";
}

enum List<T> {
    Cons(head: T, tail: List<T>),
    Nil,
}

fn Largest<T: Shape>(a: T, b: T) => T = if a.Area() >= b.Area() { a } else { b };

fn Summary<T: Shape>(shape: T) => string = shape.Describe();

fn TotalArea(shapes: List<Shape>) => double = match shapes {
    Cons(s, rest) => s.Area() + TotalArea(rest),
    Nil => 0.0,
};

trait Speak {
    fn Sound() => string;
    fn Speak() => string = $"says {this.Sound()}";
}

enum Animal {
    Dog(name: string),
    Cat(name: string, lives: int),
}

extend Animal: Speak {
    fn Sound() => string = match this {
        Dog(_) => "woof",
        Cat(_, _) => "meow",
    };

    fn Nickname() => string = match this {
        Dog(n) => n,
        Cat(n, _) => n,
    };
}

fn Main() {
    let c = Circle(1.0);
    let r = Rect(2.0, 3.0);
    Print(c.Describe());
    Print(r.Describe());
    Print(Summary(Rect(2.0, 2.0)));
    Print(Largest(c, Circle(2.0)).radius);

    let s: Shape = if r.Area() > c.Area() { r } else { c };
    Print(s.Name());

    let shapes: List<Shape> = List.Cons(c, List.Cons(r, List.Cons(Rect(1.0, 1.0), List.Nil)));
    Print(TotalArea(shapes));

    let tom = Animal.Cat("Tom", 9);
    Print($"{tom.Nickname()} {tom.Speak()}");
    Print($"{Animal.Dog("Rex").Nickname()} {Animal.Dog("Rex").Speak()}");
}
