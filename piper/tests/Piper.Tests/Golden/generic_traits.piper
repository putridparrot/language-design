// Generic traits, including one whose type parameter is bounded by the trait itself (as .NET's IComparable<T>).

using System.Collections.Generic;

trait Convert<T> {
    fn Convert() => T;
    fn Describe() => string = "converts to {this.Convert()}";
}

trait Comparable<T: Comparable<T>> {
    fn CompareTo(other: T) => int;
    fn IsLessThan(other: T) => bool = this.CompareTo(other) < 0;
}

record Celsius(degrees: double);
record Money(pence: int);
record Box<T>(value: T);

extend Celsius: Convert<string> {
    fn Convert() => string = "{this.degrees} C";
}

extend Money: Comparable<Money>, Convert<int> {
    fn CompareTo(other: Money) => int = this.pence - other.pence;
    fn Convert() => int = this.pence;
}

// A generic type can implement a trait in terms of its own type parameter.
extend Box: Convert<T> {
    fn Convert() => T = this.value;
}

fn Largest<T: Comparable<T>>(items: List<T>) => T {
    mut best = items[0];
    for item in items {
        if best.IsLessThan(item) {
            best = item;
        }
    }
    best
}

fn Total<T: Convert<int>>(items: List<T>) => int {
    mut sum = 0;
    for item in items {
        sum += item.Convert();
    }
    sum
}

fn Main() {
    let c = Celsius(21.5);
    Print(c.Convert());
    Print(c.Describe());

    // A generic trait is a type too.
    let converters: List<Convert<string>> = [c, Box("boxed")];
    for converter in converters {
        Print(converter.Describe());
    }

    let wallet = [Money(250), Money(1200), Money(75)];
    Print(Largest(wallet));
    Print(Total(wallet));
    Print(Total([Box(1), Box(2), Box(3)]));
    Print(Money(5).IsLessThan(Money(6)));
}
