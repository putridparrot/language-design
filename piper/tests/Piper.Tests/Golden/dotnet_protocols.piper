// How Piper types take part in .NET's everyday protocols: printing (ToString), ordering (IComparable<T>, which also
// gives <, <=, > and >=), iteration (IEnumerable<T>), and .NET's own implicit conversions.

using System;
using System.Collections.Generic;
using System.Linq;
using System.Numerics;
using System.Xml.Linq;

// ToString: records and enums replace the one C# generates.
record Money(amount: decimal);
extend Money {
    override fn ToString() => string = "£{this.amount}";
}

enum Suit { Hearts, Spades, Joker(n: int) }
extend Suit {
    override fn ToString() => string = match this { Hearts => "♥", Spades => "♠", Joker(n) => "Joker {n}" };
}

// IComparable<T> for the type itself: sorting, Max, and the comparison operators.
record Version(major: int, minor: int);
extend Version: IComparable<Version> {
    fn CompareTo(other: Version?) => int = match other {
        Some(o) => if this.major != o.major { this.major - o.major } else { this.minor - o.minor },
        None => 1,
    };
    override fn ToString() => string = "{this.major}.{this.minor}";
}

class Score(points: int): IComparable<Score> {
    public let value = points;
    fn CompareTo(other: Score?) => int = points - (other?.value ?? 0);
}

// IEnumerable<T>: GetEnumerator is an iterator, and the type works with for, LINQ and anything taking a sequence.
record Countdown(from: int);
extend Countdown: IEnumerable<int> {
    fn GetEnumerator() => IEnumerator<int> {
        mut i = this.from;
        while i > 0 {
            yield return i;
            i -= 1;
        }
    }
}

class Deck(suits: List<Suit>): IEnumerable<Suit> {
    fn GetEnumerator() => IEnumerator<Suit> {
        for suit in suits {
            yield return suit;
        }
    }
}

// An implicit conversion applies where a BigInteger is expected.
fn Doubled(n: BigInteger) => BigInteger = n * 2;

fn Main() {
    Print(Money(2.5m));
    Print("{Suit.Hearts} {Suit.Joker(2)} {Option.Some(Money(1m))}");

    let versions = [Version(1, 5), Version(1, 2), Version(0, 9)];
    Print(Version(1, 2) < Version(1, 3));
    Print(Version(2, 0) >= Version(1, 9));
    Print(string.Join(", ", versions.Order()));
    versions.Sort();
    Print(versions[0]);
    Print(Score(5) > Score(3));

    for n in Countdown(3) {
        Print(n);
    }
    Print(Countdown(4).Sum());
    Print(string.Join(" ", Countdown(5).Where(n => n % 2 == 1)));
    let deck = Deck([Suit.Spades, Suit.Hearts]);
    Print(deck.Count());
    for suit in deck {
        Print(suit);
    }

    Print(BigInteger.Pow(2, 70));
    let big: BigInteger = 7;
    Print(big + 1);
    Print(Doubled(21));
    let root = XElement("root", XElement("child", "text"));
    Print(root.Element("child")?.Value ?? "missing");
}
