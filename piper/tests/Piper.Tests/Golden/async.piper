// async and await, as in C#.

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

record User(id: int, name: string);

trait Store {
    fn Load(id: int) => Task<User?>;
}

record MemoryStore(users: List<User>);

// A trait method can be implemented by an async one.
extend MemoryStore: Store {
    async fn Load(id: int) => Task<User?> {
        await Task.Delay(1);
        for user in this.users {
            if user.id == id {
                return user;
            }
        }
        null
    }
}

async fn Twice(x: int) => Task<int> {
    await Task.Yield();
    x * 2
}

// No return type: an async function returns a plain Task.
async fn Log(message: string) {
    await Task.Delay(1);
    Print($"log: {message}");
}

// `?` works inside async functions too.
async fn NameOf(store: Store, id: int) => Task<string?> {
    let user = (await store.Load(id))?;
    user.name.ToUpper()
}

async fn Fail() => Task<int> {
    await Task.Delay(1);
    throw InvalidOperationException("boom")
}

fn Sum(values: int[]) => int = values.Sum();

async fn Main() {
    Print(await Twice(21));
    await Log("started");

    let store = MemoryStore([User(1, "ada"), User(2, "grace")]);
    Print(await NameOf(store, 2) ?? "?");
    Print(await NameOf(store, 9) ?? "nobody");

    // Async lambdas, Task.WhenAll and LINQ.
    let doubled = await Task.WhenAll([1, 2, 3].Select(async n => await Twice(n)));
    Print(string.Join(",", doubled));
    Print(Sum(await Task.WhenAll(Task.FromResult(4), Twice(5))));
    let squared = await Task.Run(async () => {
        await Task.Delay(1);
        7 * 7
    });
    Print(squared);

    // ValueTask, ConfigureAwait, and awaiting in expressions and conditions.
    let ready = ValueTask<int>(5);
    Print(await ready + await Twice(1).ConfigureAwait(false));
    if await Twice(2) > 3 {
        Print("big enough");
    }
    Print($"in a string: {await Twice(10)}");

    // Exceptions come through await unchanged.
    try {
        Print(await Fail());
    } catch (e: InvalidOperationException) {
        Print($"caught {e.Message}");
    }

    // An async function value.
    let fetch: (int) => Task<int> = async n => await Twice(n) + 100;
    Print(await fetch(1));

    // `await for` over an IAsyncEnumerable (C#'s await foreach), here a channel's items.
    let channel = System.Threading.Channels.Channel.CreateUnbounded<int>();
    for n in 1..3 {
        channel.Writer.TryWrite(n * n);
    }
    channel.Writer.Complete();
    mut total = 0;
    await for square in channel.Reader.ReadAllAsync() {
        total += square;
    }
    Print($"squares total {total}");

    // `await using` disposes with DisposeAsync.
    let stream = System.IO.MemoryStream();
    {
        await using let resource = stream;
        Print($"open: {resource.CanRead}");
    }
    Print($"after await using: {stream.CanRead}");
}
