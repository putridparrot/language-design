// .NET `ref` parameters and events.

using System;
using System.Threading;
using System.Collections.ObjectModel;
using System.Collections.Specialized;

fn OnChange(sender: object, e: NotifyCollectionChangedEventArgs) {
    Print("changed: {e.Action}");
}

fn Main() {
    // `ref` passes a `var` variable, which .NET may change.
    mut counter = 0;
    Interlocked.Increment(ref counter);
    Interlocked.Add(ref counter, 10);
    Print(counter);
    let old = Interlocked.Exchange(ref counter, 100);
    Print("{old} -> {counter}");

    // Type arguments are inferred through ref, and array elements can be passed too.
    mut items: int[] = [1, 2, 3];
    Array.Resize(ref items, 5);
    Print("{items.Length}: {string.Join(",", items)}");
    Interlocked.Increment(ref items[0]);
    Print(items[0]);

    // Events: add a handler with += and remove it with -=.
    let names: ObservableCollection<string> = ObservableCollection();
    names.CollectionChanged += OnChange;
    names.Add("Ada");
    names.CollectionChanged += (sender, e) => Print("now {names.Count} names");
    names.Add("Bob");
    names.CollectionChanged -= OnChange;
    names.Remove("Ada");
}
