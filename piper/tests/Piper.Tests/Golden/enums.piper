// Enums are sum types: a Shape is exactly one of its variants.

enum Shape {
    Circle(radius: double),
    Rect(width: double, height: double),
    Empty,
}

fn Area(shape: Shape) => double = match shape {
    Circle(r) => 3.0 * r * r,
    Rect(w, h) => w * h,
    Empty => 0.0,
};

fn Describe(shape: Shape) => string {
    match shape {
        Shape.Circle(r) if r > 10.0 => "a big circle",
        Circle(_) => "a circle",
        Rect(w, h) if w == h => "a {w}x{h} square",
        Rect(_, _) => "a rectangle",
        Empty => "nothing",
    }
}

fn Initial(shape: Shape) => char {
    let letter = match shape {
        Circle(_) => 'C',
        Rect(_, _) => 'R',
        Empty => return '-',
    };
    letter
}

fn Main() {
    let shapes = Shape.Rect(2.0, 3.0);
    Print(Area(Shape.Circle(2.0)));
    Print(Area(shapes));
    Print(Area(Shape.Empty));
    Print(Describe(Shape.Circle(20.0)));
    Print(Describe(Shape.Circle(1.0)));
    Print(Describe(Shape.Rect(4.0, 4.0)));
    Print(Describe(shapes));
    Print(Describe(Shape.Empty));
    Print("{Initial(shapes)}{Initial(Shape.Circle(1.0))}{Initial(Shape.Empty)}");
    Print(Shape.Rect(2.0, 3.0) == shapes);
    Print(shapes);

    // A match used as a statement; its arms run for their effect.
    match shapes {
        Rect(w, _) if w > 1.0 => Print("wide"),
        _ => {}
    }
}
