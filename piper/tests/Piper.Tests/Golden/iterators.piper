// Iterators, as in C#: functions that `yield` produce sequences lazily.

using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

// An endless sequence: only as much is computed as the caller takes.
fn Fibonacci() => IEnumerable<long> {
    mut (a, b) = (0L, 1L);
    while true {
        yield return a;
        (a, b) = (b, a + b);
    }
}

fn Countdown(from: int) => IEnumerable<int> {
    for i in 0..from {
        if from - i < 0 {
            yield break;
        }
        yield return from - i;
    }
}

// Generic, and stopping early with `yield break`.
fn TakeWhileSmall<T>(items: IEnumerable<T>, limit: int, size: (T) => int) => IEnumerable<T> {
    for item in items {
        if size(item) > limit {
            yield break;
        }
        yield return item;
    }
}

fn Noisy(name: string) => IEnumerable<string> {
    Print("start {name}");
    yield return "{name}1";
    Print("middle {name}");
    yield return "{name}2";
    Print("end {name}");
}

record Tree(value: int, children: List<Tree>);

extend Tree {
    // An iterator method, walking the tree depth-first.
    fn Walk() => IEnumerable<int> {
        yield return this.value;
        for child in this.children {
            for value in child.Walk() {
                yield return value;
            }
        }
    }
}

// `try`/`finally` around `yield return` is allowed (the finally runs when iteration stops).
fn Guarded() => IEnumerable<int> {
    try {
        yield return 1;
        yield return 2;
    } finally {
        Print("cleaned up");
    }
}

// An async iterator, consumed with `await for`.
async fn Ticks(count: int) => IAsyncEnumerable<int> {
    for i in 1..count {
        await Task.Yield();
        yield return i * 10;
    }
}

async fn Main() {
    Print(string.Join(", ", Fibonacci().Take(10)));
    Print(string.Join(", ", Countdown(3)));
    Print(string.Join(", ", TakeWhileSmall(["a", "bb", "ccc", "d"], 2, s => s.Length)));

    // Lazy: nothing runs until iteration, and only as far as needed.
    let lazy = Noisy("x");
    Print("created");
    Print(lazy.First());

    let tree = Tree(1, [Tree(2, [Tree(3, [])]), Tree(4, [])]);
    Print(string.Join(" ", tree.Walk()));

    Print(Guarded().First());

    mut total = 0;
    await for tick in Ticks(3) {
        total += tick;
    }
    Print("ticks total {total}");
}
