// C#'s numeric types, literals, conversions and casts.

using System;
using System.IO;

trait Shape {
    fn Area() => double;
}

record Square(side: double);

extend Square: Shape {
    fn Area() => double = this.side * this.side;
}

fn Describe(b: byte) => string = match b {
    0 => "zero",
    1..9 => "small",
    255 => "max",
    _ => "other",
};

fn Main() {
    // Literal suffixes: F float, D double, M decimal, U uint, UL ulong (and L long).
    let f = 1.5f;
    let d = 2.5d;
    let m = 19.99m;
    let u = 4_000_000_000u;
    let ul = 10UL;
    Print($"{f} {d} {m} {u} {ul}");

    // decimal is exact, double isn't.
    Print(0.1 + 0.2 == 0.3);
    Print(0.1m + 0.2m == 0.3m);
    Print(m * 3);

    // Constants convert implicitly where they fit, as in C#.
    let b: byte = 200;
    mut small: short = -5;
    small += 10;
    Print($"{b} {small}");

    // Arithmetic on small types is done as int: byte + byte is an int.
    let sum = b + b;
    Print(sum);
    mut counter: byte = 250;
    counter += 10;
    Print(counter);

    // byte arrays and streams.
    let stream = MemoryStream();
    stream.WriteByte(7);
    stream.WriteByte(255);
    let bytes = stream.ToArray();
    Print($"{bytes.Length} bytes, last {bytes[1]}, {Describe(bytes[1])}, {Describe(bytes[0])}");
    let buffer = byte[4];
    buffer[0] = 1;
    Print(string.Join(",", buffer));

    // Casts, as in C#: truncating, wrapping when not constant, and char codes.
    Print((int)2.7);
    Print((int)(-2.7));
    let wide = 300;
    Print((byte)wide);
    Print((char)65);
    Print((int)'A' + 1);
    Print('a' + 1);
    Print((char)('a' + 1));
    let a = 100_000;
    Print((long)a * a);
    Print(Math.Max(b, (byte)3));

    // Downcasts, which throw if the value is something else.
    let anything: object = "text";
    let text = (string)anything;
    Print(text.Length);
    let shape: Shape = Square(3.0);
    Print(((Square)shape).side);
    try {
        Print((string)(object)42);
    } catch (e: InvalidCastException) {
        Print("not a string");
    }

    // Unsigned and float arithmetic follow C#'s promotions.
    let count: uint = 3;
    Print(count * u);
    Print(f * 2);
    Print(f * 2.0);
}
