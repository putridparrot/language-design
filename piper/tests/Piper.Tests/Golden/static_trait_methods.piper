// Static trait methods: C# 11 static abstract interface members, called through a type parameter.

using System.Collections.Generic;

trait Monoid<T: Monoid<T>> {
    static fn Empty() => T;
    fn Combine(other: T) => T;
    // A default static method; implementers may override it.
    static fn Describe() => string = "a monoid";
}

record Total(amount: int);
record Text(value: string);

extend Total: Monoid<Total> {
    static fn Empty() => Total = Total(0);
    fn Combine(other: Total) => Total = Total(this.amount + other.amount);
}

extend Text: Monoid<Text> {
    static fn Empty() => Text = Text("");
    fn Combine(other: Text) => Text = Text(this.value + other.value);
    static fn Describe() => string = "text, joined";
}

// `T.Empty()` calls the implementing type's static method.
fn Concat<T: Monoid<T>>(items: List<T>) => T {
    mut result = T.Empty();
    for item in items {
        result = result.Combine(item);
    }
    result
}

fn Describe<T: Monoid<T>>() => string = T.Describe();

fn Main() {
    Print(Concat([Total(1), Total(2), Total(3)]));
    Print(Concat([Text("pi"), Text("p"), Text("er")]));
    let none: List<Total> = [];
    Print(Concat(none));

    // A type's own static methods can be called on it directly.
    Print(Total.Empty());
    Print(Describe<Total>());
    Print(Describe<Text>());
}
