// Throwing and catching .NET exceptions.

using System;

fn Divide(a: int, b: int) => int {
    if b == 0 {
        throw ArgumentException("b must not be zero");
    }
    a / b
}

fn Parse(text: string) => int {
    try {
        return int.Parse(text);
    } catch (e: FormatException) {
        Print("not a number: {text}");
    }
    -1
}

fn Check(value: int) => int = if value >= 0 { value } else { throw InvalidOperationException("negative") };

fn Main() {
    Print(Divide(10, 2));

    try {
        Print(Divide(1, 0));
    } catch (e: ArgumentException) {
        Print("caught: {e.Message}");
    } finally {
        Print("finally runs");
    }

    Print(Parse("12"));
    Print(Parse("twelve"));

    // A catch without a type catches everything; `_` ignores the exception.
    try {
        Print(Check(-1));
    } catch (_) {
        Print("check failed");
    }

    try {
        let items = [1, 2];
        Print(items[5]);
    } catch (e) {
        Print(e.GetType().Name);
    }
}
