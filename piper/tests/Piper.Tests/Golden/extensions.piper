// extend adds methods to existing types: builtins (as C# 14 extension members)
// and user records and enums (as members of the generated C# type).

extend Int {
    fn squared(self) -> Int = self * self;
    fn isEven(self) -> Bool = self % 2 == 0;
    fn clamp(self, low: Int, high: Int) -> Int = if self < low { low } else if self > high { high } else { self };
    fn zero() -> Int = 0;
}

extend String {
    fn shout(self) -> String = self + "!";

    fn repeat(self, times: Int) -> String {
        var result = "";
        for i in 0..times { result = result + self; }
        result
    }
}

extend Double {
    fn half(self) -> Double = self / 2.0;
}

record Point(x: Int, y: Int);

extend Point {
    fn origin() -> Point = Point(0, 0);
    fn plus(self, other: Point) -> Point = Point(self.x + other.x, self.y + other.y);
    fn lengthSquared(self) -> Int = self.x.squared() + self.y.squared();
}

enum Option<T> {
    Some(value: T),
    None,
}

extend Option {
    fn isSome(self) -> Bool = match self { Some(_) => true, None => false };
    fn getOr(self, fallback: T) -> T = match self { Some(v) => v, None => fallback };
    fn none() -> Option<T> = Option.None;
}

fn main() {
    print(7.squared());
    print((-3).squared());
    print(4.isEven());
    print(15.clamp(0, 10));
    print(Int.zero());
    print("hey".shout());
    print("ab".repeat(3));
    print(3.0.half());

    let p = Point.origin().plus(Point(2, 3)).plus(Point(1, 1));
    print("{p.x},{p.y} -> {p.lengthSquared()}");

    let o: Option<String> = Option.none();
    print(o.isSome());
    print(o.getOr("default"));
    print(Option.Some(5).getOr(0));
}
