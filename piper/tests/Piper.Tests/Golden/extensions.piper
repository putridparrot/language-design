// extend adds methods to existing types: builtins (as C# 14 extension members)
// and user records and enums (as members of the generated C# type).

extend int {
    fn Squared() => int = this * this;
    fn IsEven() => bool = this % 2 == 0;
    fn ClampTo(low: int, high: int) => int = if this < low { low } else if this > high { high } else { this };
    static fn Zero() => int = 0;
}

extend string {
    fn Shout() => string = this + "!";

    fn Repeat(times: int) => string {
        mut result = "";
        for i in 0..<times { result = result + this; }
        result
    }
}

extend double {
    fn Half() => double = this / 2.0;
}

record Point(x: int, y: int);

extend Point {
    static fn Origin() => Point = Point(0, 0);
    fn Plus(other: Point) => Point = Point(this.x + other.x, this.y + other.y);
    fn LengthSquared() => int = this.x.Squared() + this.y.Squared();
}

extend Option {
    fn HasValue() => bool = match this { Some(_) => true, None => false };
    fn GetOr(fallback: T) => T = match this { Some(v) => v, None => fallback };
    static fn Nothing() => Option<T> = Option.None;
}

fn Main() {
    Print(7.Squared());
    Print((-3).Squared());
    Print(4.IsEven());
    Print(15.ClampTo(0, 10));
    Print(int.Zero());
    Print("hey".Shout());
    Print("ab".Repeat(3));
    Print(3.0.Half());

    let p = Point.Origin().Plus(Point(2, 3)).Plus(Point(1, 1));
    Print("{p.x},{p.y} -> {p.LengthSquared()}");

    let o: Option<string> = Option.Nothing();
    Print(o.HasValue());
    Print(o.GetOr("default"));
    Print(Option.Some(5).GetOr(0));
}
