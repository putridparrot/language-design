// `requires`: preconditions on functions and methods, and invariants on records.
using System;
using System.Collections.Generic;
using System.Threading.Tasks;

fn Sqrt(x: double) => double
    requires x >= 0.0
= Math.Sqrt(x);

fn Slice(items: List<int>, start: int, count: int) => List<int>
    requires start >= 0, count >= 0
    requires start + count <= items.Count
{
    items.GetRange(start, count)
}

record Percentage(value: int) requires value >= 0 && value <= 100;

record Range(low: int, high: int) requires low <= high;

// A condition can bind with `is`, as an if's can.
fn Positive(n: int?) => int requires n is Some(v) && v > 0 = n ?? 0;

extend Range {
    fn Contains(n: int) => bool = n >= this.low && n <= this.high;

    // A method's precondition can mention `this`.
    fn Widen(by: int) => Range requires by >= 0 = Range(this.low - by, this.high + by);

    operator +(other: Range) => Range requires other.low >= this.low = Range(this.low, Math.Max(this.high, other.high));
}

async fn Delay(ms: int) => Task<int> requires ms >= 0 {
    await Task.Delay(ms);
    ms
}

fn Attempt(label: string, action: () => string) {
    try {
        Print($"{label}: {action()}");
    } catch (e: ArgumentException) {
        Print($"{label}: {e.Message}");
    }
}

async fn Main() {
    let size = 16.0;
    Attempt("sqrt 16", () => Sqrt(size).ToString());
    let negative = -size;
    Attempt("sqrt -16", () => Sqrt(negative).ToString());

    let numbers = [1, 2, 3, 4, 5];
    Attempt("slice 1..3", () => string.Join(",", Slice(numbers, 1, 3)));
    let tooMany = 9;
    Attempt("slice too far", () => string.Join(",", Slice(numbers, 1, tooMany)));

    let half = Percentage(50);
    Print(half);
    let big = 150;
    Attempt("150%", () => $"{Percentage(big)}");
    // A copy is checked too.
    Attempt("copy to 75%", () => $"{ { ...half, value: 75 } }");
    Attempt("copy to -1%", () => $"{ { ...half, value: -1 } }");

    let r = Range(1, 5);
    Print($"{r.Contains(3)} {r.Widen(2)} {r + Range(3, 9)}");
    let shrink = -1;
    Attempt("widen -1", () => $"{r.Widen(shrink)}");
    Attempt("add lower", () => $"{r + Range(0, 2)}");

    Print(Positive(3));
    let none: int? = null;
    Attempt("positive none", () => $"{Positive(none)}");

    Print(await Delay(1));
    try {
        let wait = -1;
        Print(await Delay(wait));
    } catch (e: ArgumentException) {
        Print($"delay: {e.Message} [{e.ParamName ?? "?"}]");
    }
}
