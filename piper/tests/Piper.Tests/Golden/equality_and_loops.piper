// Equality through generics and traits, infinite loops, and `|` patterns that bind variables.

using System.Collections.Generic;

trait Shape {
    fn Area() => double;
}

record Circle(radius: double);

record Square(side: double);

extend Circle: Shape {
    fn Area() => double = 3.0 * this.radius * this.radius;
}

extend Square: Shape {
    fn Area() => double = this.side * this.side;
}

enum Event {
    Click(x: int, y: int),
    Touch(x: int, y: int),
    Key(code: int),
}

// == on a type parameter compares by value, as Equals does.
fn IndexOf<T>(items: List<T>, wanted: T) => int {
    for i in 0..<items.Count {
        if items[i] == wanted {
            return i;
        }
    }
    -1
}

fn Same(a: Shape, b: Shape) => bool = a == b;

// No `break`, so the loop never ends normally: no "not all paths return" error.
fn FirstSquareAbove(limit: int) => int {
    mut n = 1;
    while true {
        if n * n > limit {
            return n * n;
        }
        n += 1;
    }
}

fn Describe(event: Event) => string = match event {
    Click(x, y) | Touch(x, y) if x == y => "on the diagonal at {x}",
    Click(x, y) | Touch(x, y) => "pointer at ({x}, {y})",
    Key(code) => "key {code}",
};

fn Bucket(pair: (int, int?)) => string = match pair {
    (0, Some(n)) | (n, None) => "one number: {n}",
    (a, Some(b)) => "two numbers: {a}, {b}",
};

fn Main() {
    let names: List<string> = ["ann", "bob", "cy"];
    Print(IndexOf(names, "bob"));
    Print(IndexOf([Circle(1.0), Circle(2.0)], Circle(2.0)));
    Print(IndexOf([1, 2, 3], 7));

    Print(Same(Circle(1.0), Circle(1.0)));
    Print(Same(Circle(1.0), Square(1.0)));
    let shape: Shape = Square(2.0);
    Print(shape == Square(2.0));
    Print(shape != Square(3.0));

    Print(FirstSquareAbove(50));

    Print(Describe(Event.Click(3, 3)));
    Print(Describe(Event.Touch(1, 5)));
    Print(Describe(Event.Key(13)));

    Print(Bucket((0, 9)));
    Print(Bucket((4, null)));
    Print(Bucket((2, 3)));
}
