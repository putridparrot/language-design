// `defer`: run code when the enclosing block ends, however it ends (as Swift's defer).

using System.Collections.Generic;

fn Log(message: string) {
    Print(message);
}

// Deferred code runs after the block's value is computed, and on every exit path.
fn Compute(n: int) => int {
    Log("compute {n}");
    defer Log("leaving compute {n}");
    if n < 0 {
        return 0;
    }
    n * 2
}

fn Risky(fail: bool) {
    defer { Log("cleanup"); }
    if fail {
        throw System.InvalidOperationException("boom");
    }
    Log("worked");
}

fn Numbers() => IEnumerable<int> {
    defer Log("iterator done");
    yield return 1;
    yield return 2;
}

fn Main() {
    // Several defers run in reverse order.
    {
        defer Log("first deferred");
        defer Log("second deferred");
        Log("body");
    }

    Print(Compute(5));
    Print(Compute(-1));

    try {
        Risky(true);
    } catch (e) {
        Log("caught {e.Message}");
    }
    Risky(false);

    // Each loop iteration is its own block.
    for i in 0..<3 {
        defer Log("end of iteration {i}");
        if i == 1 {
            continue;
        }
        Log("iteration {i}");
    }

    // A block with a value, and a defer that sees the variables declared before it.
    mut counter = 0;
    let value = {
        counter += 1;
        defer counter += 10;
        counter * 100
    };
    Print("{value} {counter}");

    // Temporaries never clash with each other or with your names.
    let result = { defer Log("a"); 1 };
    let other = { defer Log("b"); 2 };
    Print(result + other);

    for n in Numbers() {
        Print(n);
    }
}
