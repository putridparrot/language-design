// params: a function's last parameter taking any number of arguments as an array, as in C#.
using System.Linq;

fn Sum(params values: int[]) => int = values.Sum();

fn Log(format: string, params args: object[]) {
    Print(string.Format(format, args));
}

fn Join(separator: string = ", ", params parts: string[]) => string = string.Join(separator, parts);

fn First<T>(params items: T[]) => T = items[0];

record Counter(start: int);

extend Counter {
    fn Add(params amounts: int[]) => int = this.start + amounts.Sum();
}

fn Main() {
    Print(Sum());
    Print(Sum(1));
    Print(Sum(1, 2, 3));
    let values: int[] = [4, 5];
    Print(Sum(values));
    Print(Sum(values: [6, 7]));
    Log("{0} of {1}", 1, 2);
    Log("none");
    Print(Join());
    Print(Join(" | ", "a", "b"));
    Print(First("x", "y"));
    Print(First(values));
    Print(Counter(10).Add(1, 2));
}
