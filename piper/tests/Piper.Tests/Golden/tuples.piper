// Tuples and deconstruction, as in C#: (int, string) is a ValueTuple.

using System;
using System.Collections.Generic;

record Point(x: int, y: int);

// Several results at once.
fn Divide(a: int, b: int) => (quotient: int, remainder: int) = (a / b, a % b);

fn Swap<A, B>(pair: (A, B)) => (B, A) = (pair.Item2, pair.Item1);

fn Describe(cell: (bool, bool)) => string = match cell {
    (true, true) => "both",
    (true, false) | (false, true) => "one",
    (false, false) => "neither",
};

fn Classify(point: (int, int)) => string = match point {
    (0, 0) => "origin",
    (0, _) | (_, 0) => "axis",
    (x, y) if x == y => "diagonal",
    _ => "elsewhere",
};

fn Main() {
    // Literals, element names and positional access.
    let pair = (1, "one");
    Print(pair);
    Print(pair.Item1 + 1);
    let result = Divide(17, 5);
    Print($"{result.quotient} r {result.remainder}");
    Print(result.Item2);

    // Names are inferred from variables and members, as in C#.
    let p = Point(3, 4);
    let name = "p";
    let labelled = (name, p.x);
    Print($"{labelled.name} {labelled.x}");

    // Deconstruction: tuples, records (by field), and .NET types with Deconstruct.
    let (q, r) = Divide(7, 2);
    Print($"{q} {r}");
    let (px, py) = p;
    Print(px * py);
    let (first, (_, third)) = (1, (2, 3));
    Print(first + third);

    mut a = 1;
    mut b = 2;
    (a, b) = (b, a);
    Print($"{a} {b}");

    let ages: Dictionary<string, int> = Dictionary();
    ages["Ada"] = 36;
    ages["Grace"] = 45;
    for (who, age) in ages {
        Print($"{who}: {age}");
    }
    for (index, word) in [(1, "a"), (2, "b")] {
        Print($"{index}{word}");
    }

    // Generic functions, conversions and equality.
    Print(Swap((1, "x")));
    let widened: (long, int?) = (1, 2);
    Print(widened.Item1 + 3_000_000_000L);
    Print((1, 2) == (1, 2));
    Print(result == (3, 2));
    Print((1, "a") != (1, "b"));

    // Matching: tuple patterns, checked for exhaustiveness.
    Print(Describe((true, false)));
    Print(Describe((false, false)));
    Print(Classify((0, 5)));
    Print(Classify((2, 2)));
    Print(Classify((1, 2)));

    // .NET methods returning tuples.
    let (quotient, remainder) = Math.DivRem(20, 6);
    Print($"{quotient} {remainder}");

    // Their element names come with them, even inside other types.
    let division = Math.DivRem(20, 6);
    Print($"{division.Quotient} r {division.Remainder}");
    let unnamed: (int, int) = division;
    Print(unnamed.Item1);
    for entry in System.Linq.Enumerable.Index(["a", "b"]) {
        Print($"{entry.Index}:{entry.Item}");
    }

    let pairs: List<(string, int)> = [("x", 1), ("y", 2)];
    Print(string.Join(";", System.Linq.Enumerable.Select(pairs, entry => $"{entry.Item1}={entry.Item2 * 10}")));
}
