// `using`, as in C#: disposing IDisposable values when a block ends.

using System;
using System.IO;

fn Lines(text: string) => int {
    // Disposed when the function returns, by whichever path.
    using let reader = StringReader(text);
    mut count = 0;
    while reader.ReadLine() is Some(line) {
        if line == "stop" {
            return count;
        }
        count += 1;
    }
    count
}

fn Size(stream: MemoryStream) => long {
    using (stream) {
        return stream.Length;
    }
}

fn Main() {
    Print(Lines("a\nb\nc"));
    Print(Lines("a\nstop\nc"));

    // A using declaration lasts until the end of its block.
    let first = MemoryStream();
    {
        using let stream = first;
        stream.SetLength(3);
        Print($"in the block: {stream.CanRead}");
    }
    Print($"after the block: {first.CanRead}");

    // ...even when the block is an expression.
    let second = MemoryStream();
    let length = {
        using let stream = second;
        stream.SetLength(2);
        stream.Length
    };
    Print($"length {length}, still open: {second.CanRead}");

    // The statement form, with a declaration or with any expression.
    using (let writer = StringWriter()) {
        writer.Write("written");
        Print(writer.ToString());
    }

    let third = MemoryStream();
    third.SetLength(5);
    Print(Size(third));
    Print($"after using (third): {third.CanRead}");
}
