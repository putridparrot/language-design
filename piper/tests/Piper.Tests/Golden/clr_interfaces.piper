// Implementing .NET interfaces with extend, and using them as bounds.

using System;
using System.Collections.Generic;
using System.Linq;

record Money(pence: int);

// IComparable<T>.CompareTo takes a T? (.NET may pass null), so in Piper the parameter is an Option.
extend Money: IComparable<Money> {
    fn CompareTo(other: Money?) => int = match other {
        Some(o) => this.pence.CompareTo(o.pence),
        None => 1,
    };
}

record Connection(name: string);

// IDisposable makes a Piper record usable with `using`.
extend Connection: IDisposable {
    fn Dispose() {
        Print($"closing {this.name}");
    }
}

// A comparer for List.Sort: a generic interface implemented for another type.
record ByLength();

extend ByLength: IComparer<string> {
    fn Compare(x: string?, y: string?) => int = (x?.Length ?? 0) - (y?.Length ?? 0);
}

// A .NET interface as a bound: Piper types that implement it and .NET types alike.
fn Largest<T: IComparable<T>>(items: List<T>) => T {
    mut best = items[0];
    for item in items {
        if item.CompareTo(best) > 0 {
            best = item;
        }
    }
    best
}

fn Main() {
    let wallet = [Money(250), Money(1200), Money(75)];
    wallet.Sort();
    Print(string.Join(", ", wallet));
    Print(Largest(wallet));
    Print(Largest([3, 9, 4]));
    Print(Largest(["pear", "fig"]));

    {
        using let c = Connection("db");
        Print($"using {c.name}");
    }

    let words = ["banana", "fig", "apple"];
    words.Sort(ByLength());
    Print(string.Join(", ", words));

    let comparable: IComparable<Money> = Money(5);
    Print(comparable.CompareTo(Money(3)));

    // A .NET result that may be null is optional for Piper types too.
    let none: List<Money> = [];
    Print(none.FirstOrDefault() ?? Money(0));
}
