// Piper has no null references. Absence is Option<T> (written T?); `null` is just None,
// plain values become Some implicitly, and ?. ?? ? and `is` work with optional values.

record User(name: string, email: string?, age: int);

extend User {
    fn Greet() { Print($"Hello, {this.name}!"); }
}

fn Find(id: int) => User? {
    if id == 1 { return User("Ada", "ada@example.com", 36); }
    if id == 2 { return User("Bob", null, 41); }
    null
}

fn Contact(id: int) => string {
    let user = Find(id);
    let name = user?.name ?? "nobody";
    let email = user?.email ?? "no email";   // ?. flattens: user?.email is string?, not string??
    $"{name} <{email}>"
}

// `?` returns None from the function as soon as a value is missing.
fn AgeNextYear(id: int) => int? {
    let user = Find(id)?;
    user.age + 1
}

fn Describe(value: int?) => string = match value {
    null => "nothing",
    Some(n) if n < 0 => $"negative {n}",
    Some(n) => $"{n}",
};

extend Option {
    fn IsNone() => bool = this is None;
}

fn Main() {
    Print(Contact(1));
    Print(Contact(2));
    Print(Contact(3));

    Print(AgeNextYear(1));
    Print(AgeNextYear(3));

    let maybe: int? = 5;
    if maybe is Some(n) && n > 3 {
        Print($"big: {n}");
    }
    if maybe != null { Print("has a value"); }
    Print(maybe == 5);

    let nothing: int? = null;
    Print(nothing == null);
    Print(nothing.IsNone());
    Print($"{Describe(maybe)}, {Describe(nothing)}, {Describe(-2)}");

    // A statement-level ?. call only happens when there is a value.
    Find(1)?.Greet();
    Find(9)?.Greet();

    // ?? chains right to left; the last fallback makes the result non-optional.
    let first: string? = null;
    let second: string? = "second";
    Print(first ?? second ?? "default");

    // while + is: loop as long as there is a next value.
    mut current: int? = 3;
    while current is Some(c) {
        Print($"countdown {c}");
        current = if c > 1 { c - 1 } else { null };
    }
}
