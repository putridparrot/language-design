fn Main() {
    Print(1 + 2 * 3);
    Print((1 + 2) * 3);
    Print(10 - 4 - 3);
    Print(-7 / 2);
    Print(-7 % 3);
    Print(- -5);
    Print(2147483647L + 1);
    Print(1 < 2 && 2 < 3);
    Print(!(1 == 1) || false);
    Print('a' < 'b');
    Print(1 == 1.0);
    let flag = !true;
    Print(flag);
    mut n = 10;
    n *= 3;
    n /= 4;
    n %= 4;
    n -= 1;
    Print(n);

    // The minimum values can be written as literals, as in C#; arithmetic wraps on overflow (unchecked).
    let min = -2147483648;
    Print(min == int.MinValue);
    Print(-9223372036854775808L == long.MinValue);
    let max = int.MaxValue;
    Print(max + 1 == min);
    Print(match min { -2147483648 => "min", _ => "other" });

    // Constant arithmetic is checked, as in C#, so only these overflow-free forms compile.
    Print(int.MaxValue + 1L);
    Print(int.MaxValue - 1);
    Print(1.0 / 0);
}
