fn main() {
    print(1 + 2 * 3);
    print((1 + 2) * 3);
    print(10 - 4 - 3);
    print(-7 / 2);
    print(-7 % 3);
    print(- -5);
    print(2147483647L + 1);
    print(1 < 2 && 2 < 3);
    print(!(1 == 1) || false);
    print('a' < 'b');
    print(1 == 1.0);
    let flag = !true;
    print(flag);
    var n = 10;
    n *= 3;
    n /= 4;
    n %= 4;
    n -= 1;
    print(n);

    // The minimum values can be written as literals, as in C#; arithmetic wraps on overflow (unchecked).
    let min = -2147483648;
    print(min == Int.MinValue);
    print(-9223372036854775808L == Long.MinValue);
    let max = Int.MaxValue;
    print(max + 1 == min);
    print(match min { -2147483648 => "min", _ => "other" });
}
