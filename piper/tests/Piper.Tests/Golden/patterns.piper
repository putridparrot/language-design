// Literal, range, alternative, record, bool and string patterns, guards, and match in loops.

record Point(x: int, y: int);

fn Classify(n: int) => string = match n {
    0 => "zero",
    1 | 2 | 3 => "small",
    4..9 => "digit",
    -9..<0 => "small negative",
    n if n < 0 => "negative {n}",
    _ => "large",
};

fn Quadrant(p: Point) => string = match p {
    Point(0, 0) => "origin",
    Point(0, _) | Point(_, 0) => "on an axis",
    Point(x, y) if x > 0 && y > 0 => "first quadrant",
    Point(x, y) if x < 0 && y > 0 => "second quadrant",
    Point(_, _) => "lower half",
};

fn Kind(c: char) => string = match c {
    'a'..'z' => "lower",
    'A'..'Z' => "upper",
    '0'..'9' => "digit",
    _ => "other",
};

fn Bits(a: bool, b: bool) => string {
    // bool matches are exhaustive without a wildcard.
    let first = match a { true => "1", false => "0" };
    first + match b { true => "1", false => "0" }
}

fn Greet(language: string) => string = match language {
    "en" => "Hello",
    "fr" => "Bonjour",
    "es" | "pt" => "Hola",
    other => "? ({other})",
};

fn Size(n: long) => string = match n {
    0 => "none",
    1..999 => "some",
    _ => "lots",
};

fn Main() {
    for n in -12..<12 {
        if n % 4 == 0 || n == -3 || n == 2 || n == 7 { Print("{n}: {Classify(n)}"); }
    }
    Print(Quadrant(Point(0, 0)));
    Print(Quadrant(Point(0, 5)));
    Print(Quadrant(Point(3, 4)));
    Print(Quadrant(Point(-3, 4)));
    Print(Quadrant(Point(1, -1)));
    Print("{Kind('q')} {Kind('Q')} {Kind('7')} {Kind('?')}");
    Print("{Bits(true, false)} {Bits(false, true)}");
    Print("{Greet("fr")} {Greet("pt")} {Greet("de")}");
    Print("{Size(0L)} {Size(500L)} {Size(5000000000L)}");

    // break and continue inside match arms affect the enclosing loop.
    mut found = -1;
    for i in 1..<100 {
        match i % 7 {
            0 => {
                found = i;
                break;
            }
            _ => continue,
        }
    }
    Print("first multiple of 7: {found}");

    // A match passed straight to a function.
    Print(match found { 7 => "as expected", _ => "surprising" });

    // Ranges that cover every byte need no wildcard.
    for b in [(byte)3, (byte)200] {
        Print(match b { 0..127 => "low", 128..255 => "high" });
    }
}
