// Bitwise operators, shifts and their assignments, and `??=`, as in C#.
using System.IO;
using System.Numerics;

fn CountBits(n: uint) => int {
    mut count = 0;
    mut rest = n;
    while rest != 0u {
        count += (int)(rest & 1u);
        rest >>= 1;
    }
    count
}

fn Hash(text: string) => uint {
    mut hash = 2166136261u;
    for c in text {
        hash ^= c;
        hash *= 16777619u;
    }
    hash
}

fn Main() {
    let a = 0b1100;
    let b = 0b1010;
    Print($"{a & b} {a | b} {a ^ b} {~a}");
    Print($"{1 << 10} {-16 >> 2} {1 + 2 << 3} {(a & b) == 8}");
    Print(true & false | true ^ true);

    // Constants fold, so a small enough result fits a byte.
    let mask: byte = 0x0F | 0x30;
    mut flags: byte = 0;
    flags |= 0x01;
    flags |= mask;
    flags &= 0x0F;
    flags ^= 0x01;
    Print(flags);
    flags <<= 5;
    Print(flags);

    mut wide = 17L;
    wide <<= 33;
    wide ^= wide >> 3;
    Print(wide);

    Print(CountBits(0xF0F0u));
    Print(Hash("piper"));

    // A .NET enum's values are flags.
    mut attributes = FileAttributes.ReadOnly | FileAttributes.Hidden;
    Print(attributes);
    attributes &= ~FileAttributes.ReadOnly;
    Print($"{attributes} {(attributes & FileAttributes.Hidden) == FileAttributes.Hidden}");

    // .NET types' own operators.
    let big = BigInteger.Pow(2, 70);
    Print(big >> 60 | BigInteger.One);

    mut name: string? = null;
    name ??= "first";
    name ??= "second";
    Print(name ?? "none");
}
