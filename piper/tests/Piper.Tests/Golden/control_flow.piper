fn Fizzbuzz(n: int) => string {
    if n % 15 == 0 { "FizzBuzz" } else if n % 3 == 0 { "Fizz" } else if n % 5 == 0 { "Buzz" } else { $"{n}" }
}

fn IsPrime(n: int) => bool {
    if n < 2 { return false; }
    mut d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 1;
    }
    true
}

fn Main() {
    for i in 1..15 { Print(Fizzbuzz(i)); }

    mut primes = "";
    for n in 0..<30 {
        if !IsPrime(n) { continue; }
        primes = primes + $"{n} ";
    }
    Print(primes);

    mut steps = 0;
    while true {
        steps += 1;
        if steps == 5 { break; }
    }
    Print($"stopped after {steps} steps");

    let big: long = 3_000_000_000L;
    mut total = 0L;
    for k in 0L..<3L { total += big; }
    Print(total);
}
