namespace Geometry;

using System;
using System.Text;

trait Describe {
    fn Describe() => string;
}

// Extending types declared in another file of the namespace.
extend Shape: Describe {
    fn Describe() => string {
        let text = StringBuilder();
        match this {
            Circle(center, r) => {
                text.Append("circle at ");
                text.Append(center.Label());
                text.Append(" radius ");
                text.Append(r);
            }
            Rect(corner, w, h) => {
                text.Append($"{w}x{h} rectangle at ");
                text.Append(corner.Label());
            }
        }
        text.ToString()
    }
}

extend double {
    fn Rounded() => long = (long)Math.Round(this);
}

extend Point {
    fn Label() => string = $"({this.x}, {this.y})";
}
