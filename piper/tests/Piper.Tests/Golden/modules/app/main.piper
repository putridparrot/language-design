using Geometry;
using System.Collections.Generic;

// A private type, only visible in this file.
private record Totals(count: int, area: double);

// Adding a default method to a trait declared in another file and namespace.
extend Describe {
    fn Shout() => string = this.Describe().ToUpper();
}

fn Main() {
    let circle = Shape.Circle(Point(0.0, 0.0), 1.0);
    let rect = Geometry.Shape.Rect(Geometry.Point(1.0, 2.0), 3.0, 4.0);   // fully qualified also works
    Print(circle.Describe());
    Print(rect.Describe());
    Print(circle.Shout());

    let shapes: List<Shape> = List();
    shapes.Add(circle);
    shapes.Add(rect);
    let totals = Totals(shapes.Count, Area(circle) + Geometry.Area(rect));
    Print(totals);
    Print(totals.area.Rounded());        // an extend method on a builtin, from another namespace
}
