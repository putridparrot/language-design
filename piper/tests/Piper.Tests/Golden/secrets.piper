// A Secret prints, formats and is written to JSON as ***; .Reveal() is the one way to its value, and JSON read
// into one is the value written.
using System.Text.Json;
using Piper.Runtime;

record Settings(user: string, password: Secret<string>, pin: Secret<int>?);

fn Main() {
    let password = Secret<string>("hunter2");
    Print(password);
    Print(password.ToString());
    Print(password.Reveal().Length);
    let settings = Settings("ada", password, Some(Secret<int>(1234)));
    Print(settings);
    let json = JsonSerializer.Serialize(settings);
    Print(json);
    let read = JsonSerializer.Deserialize<Settings>("{\"user\":\"bo\",\"password\":\"s3cret\",\"pin\":42}");
    if read is Some(back) {
        Print(back.password.Reveal());
        Print(back.pin?.Reveal() ?? 0);
    }
    let shown = $"{settings.user} signs in with {password.Reveal().Length} characters";
    Print(shown);
}
