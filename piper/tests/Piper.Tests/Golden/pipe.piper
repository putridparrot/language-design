// The pipe operator: `x |> f(a)` is `f(x, a)`, so a chain of calls reads left to right.

using System.Linq;

fn Twice(n: int) => int = n * 2;

fn Add(n: int, amount: int) => int = n + amount;

fn Describe(n: int, what: string) => string = $"{n} {what}";

record Box(value: int);

fn Main() {
    // A bare function, or a call whose arguments come after the piped value.
    Print(5 |> Twice);
    Print(5 |> Add(10) |> Twice |> Describe("apples"));

    // Binds looser than arithmetic and tighter than comparison: (1 + 2) |> twice, then == 6.
    Print(1 + 2 |> Twice == 6);

    // Function values, lambdas in variables, record constructors and generic functions.
    let triple = (n: int) => n * 3;
    Print(4 |> triple);
    Print(7 |> Box);
    Print("Piper" |> string.Concat("!"));

    // Static .NET methods, including LINQ called as plain functions.
    let words = ["pear", "fig", "banana"];
    let lengths = words
        |> Enumerable.Where(w => w.Length > 3)
        |> Enumerable.Select(w => w.Length)
        |> Enumerable.ToList();
    Print(string.Join(",", lengths));
    Print(-16.0 |> System.Math.Abs |> System.Math.Sqrt);

    // Evaluated left to right: the piped value before the other arguments.
    mut log = "";
    let result = { log += "a"; 1 } |> Add({ log += "b"; 2 });
    Print($"{result} {log}");
}
