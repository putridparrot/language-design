<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden *.expected.cs files are test data, not part of this project. -->
    <Compile Remove="Golden\**" />
    <None Include="Golden\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Piper.Compiler\Piper.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Piper.LanguageServer\Piper.LanguageServer.csproj" />
    <!-- Not referenced: built first so samples can load them from their piper.json, as the CLI would. -->
    <ProjectReference Include="..\..\plugins\Piper.Plugins.Parallel\Piper.Plugins.Parallel.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Piper.Plugins.Web\Piper.Plugins.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
